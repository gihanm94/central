<?php
// Template for config/config.php. The installer (public/install.php) copies it, fills in your answers and
// a random app key, and saves config/config.php. That file holds passwords: it is never stored in git.
return [
    'app' => [
        'name'     => 'Acme International',
        'url'      => 'http://localhost:8000',     // the address people use; links in e-mails are built from it
        'hosts'    => [],                          // other names this site answers to, e.g. ['192.0.2.10:8000']
        'env'      => 'production',       // production hides error details; local shows them (only on your own computer)
        'timezone' => 'Asia/Bangkok',
        'key'      => 'change-me-run-installer',
    ],
    'db' => [
        'host'     => '127.0.0.1',
        'port'     => 5432,
        'username' => 'acme',
        'password' => '',
        // One PostgreSQL database per area. Core (people, roles, logs) lives in user_db.
        'databases' => [
            'core'       => 'user_db',
            'crm'        => 'crm_db',
            'accounting' => 'account_db',
            'inventory'  => 'inventory_db',
            'machines'   => 'machine_db',
            'hr'         => 'hr_db',
        ],
        'statement_timeout_seconds' => 60,   // a runaway query in one module cannot hold the server
        // Optional: a separate PostgreSQL login per area, each allowed only into its own database, e.g.
        // 'credentials' => ['crm' => ['username' => 'acme_crm', 'password' => '…'], 'accounting' => [...]],
    ],
    'mail' => [
        'driver'       => 'log',          // log = save e-mails to storage/mail, smtp = really send
        'host'         => 'smtp.gmail.com',
        'port'         => 587,
        'encryption'   => 'tls',          // tls (587) | ssl (465) | none
        'username'     => '',
        'password'     => '',
        'from_address' => '',
        'from_name'    => 'Acme International',
    ],
    'notifications' => [
        'enabled'          => true,
        'actions'          => ['created', 'updated', 'deleted', 'import', 'export', 'download'],
        'login_alert'      => true,
        'password_changed' => true,
    ],
    'security' => [
        'remember_days'      => 30,
        'session_max_hours'  => 12,       // hard end of every sign-in (remember-me included): sign in again after this
        'session_rotate_minutes' => 10,   // the session id (the browser's access token) is replaced this often
        'reset_minutes'      => 60,
        'max_login_attempts' => 5,
        'lockout_minutes'    => 15,
        'passkey_rp_id'      => null,     // null = current host name
