{{- /* .devices, .roles, .log, .errors, .toggle, .cards, .settings */ -}}
<div class="min-w-0"><h1 class="page-title">{{__ "Mobile app & API"}}</h1>
    <p class="mt-1 text-sm text-steel">{{__ "Who is signed in on the mobile app, and every API request. Only people whose role holds “Mobile app & API” may sign in (Roles & access)."}}</p></div>

<div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {{range .cards}}
        <div class="panel p-4"><p class="text-xs text-steel">{{index . 0}}</p><p class="mt-1 text-2xl font-semibold tabular-nums">{{index . 1}}</p></div>
    {{end}}
</div>

<div class="mt-4 grid gap-4 lg:grid-cols-3">
    <section class="panel">
        <div class="panel-head"><h2 class="panel-title">{{__ "Security settings"}}</h2></div>
        <dl class="grid grid-cols-2 gap-x-4 gap-y-2 p-5 text-sm">
            <dt class="text-steel">{{__ "API"}}</dt><dd>{{if .settings.enabled}}{{__ "On"}}{{else}}{{__ "Off"}}{{end}}</dd>
            <dt class="text-steel">{{__ "HTTPS only"}}</dt><dd>{{if .settings.https}}{{__ "Yes"}}{{else}}<span class="text-amber-700">{{__ "No (local mode)"}}</span>{{end}}</dd>
            <dt class="text-steel">{{__ "Access token"}}</dt><dd>{{__ ":n minutes" "n" .settings.access}}</dd>
            <dt class="text-steel">{{__ "Stay signed in when idle"}}</dt><dd>{{__ ":n days" "n" .settings.refresh}}</dd>
            <dt class="text-steel">{{__ "Sign in again after"}}</dt><dd>{{__ ":n days" "n" .settings.max}}</dd>
            <dt class="text-steel">{{__ "Requests per device"}}</dt><dd>{{__ ":n per minute" "n" .settings.rate}}</dd>
        </dl>
        <p class="border-t border-graphite-900/8 px-5 py-3 text-xs text-steel">{{__ "Change these in config/config.php under \"api\"."}}</p>
        <div class="border-t border-graphite-900/8 px-5 py-3 text-sm"><span class="text-steel">{{__ "Roles allowed"}}:</span>
            {{if .roles}}{{.roles}}{{else}}<span class="text-amber-700">{{__ "none yet — only administrators"}}</span>{{end}}
            <a href="{{url "/roles"}}" class="ml-1 text-signal-700 hover:underline">{{__ "Roles & access"}}</a></div>
    </section>
    <section class="panel overflow-hidden lg:col-span-2">
        <div class="panel-head"><h2 class="panel-title">{{__ "Signed-in devices"}}</h2><span class="text-xs text-steel">{{len .devices}}</span></div>
        <div class="max-h-96 overflow-auto"><table class="w-full text-sm">
            <thead class="sticky top-0 bg-mist text-left text-xs text-steel"><tr><th class="px-4 py-2 font-medium">{{__ "Person"}}</th><th class="px-3 py-2 font-medium">{{__ "Device"}}</th><th class="px-3 py-2 font-medium">{{__ "Last used"}}</th><th class="px-3 py-2 font-medium">{{__ "Ends"}}</th><th></th></tr></thead>
            <tbody class="divide-y divide-graphite-900/6">{{range .devices}}
                <tr><td class="px-4 py-2"><span class="font-medium">{{.user_name}}</span><span class="block text-xs text-steel">{{.email}}</span></td>
                    <td class="px-3 py-2">{{.name}}<span class="block text-xs text-steel">{{str .platform}} · {{str .last_ip}}</span></td>
                    <td class="px-3 py-2 text-steel">{{timeAgo .last_used_at}}</td><td class="px-3 py-2 text-steel">{{formatDate .expires_at "d M Y"}}</td>
                    <td class="px-3 py-2 text-right"><form method="POST" action="{{url (printf "/api-access/devices/%v/revoke" .id)}}" data-confirm="{{__ "Sign this device out?"}}">{{csrfField}}<button class="btn-danger px-3 py-1 text-xs">{{__ "Sign out"}}</button></form></td></tr>
            {{end}}{{if not .devices}}<tr><td colspan="5" class="px-4 py-8 text-center text-steel">{{__ "Nobody is signed in on the mobile app."}}</td></tr>{{end}}</tbody>
        </table></div>
    </section>
</div>

<section class="panel mt-4 overflow-hidden">
    <div class="panel-head"><h2 class="panel-title">{{__ "Request log"}}</h2>
        <a href="{{.toggle}}" class="text-xs font-medium text-signal-700 hover:underline">{{if .errors}}{{__ "Show all"}}{{else}}{{__ "Only refused / failed"}}{{end}}</a></div>
    <div class="max-h-[32rem] overflow-auto"><table class="w-full text-sm">
        <thead class="sticky top-0 bg-mist text-left text-xs text-steel"><tr><th class="px-4 py-2 font-medium">{{__ "When"}}</th><th class="px-3 py-2 font-medium">{{__ "Person"}}</th><th class="px-3 py-2 font-medium">{{__ "Request"}}</th><th class="px-3 py-2 font-medium">{{__ "Result"}}</th><th class="px-3 py-2 text-right font-medium">ms</th><th class="px-3 py-2 font-medium">IP</th></tr></thead>
        <tbody class="divide-y divide-graphite-900/6 font-mono text-xs">{{range .log}}
            <tr><td class="whitespace-nowrap px-4 py-1.5 font-sans text-steel">{{formatDate .at "d M H:i:s"}}</td><td class="px-3 py-1.5 font-sans">{{or .user_name "—"}}</td>
                <td class="px-3 py-1.5">{{.method}} {{.path}}</td>
                <td class="px-3 py-1.5"><span class="{{.status_class}}">{{.status}}</span> {{str .error}}</td>
                <td class="px-3 py-1.5 text-right tabular-nums">{{.ms}}</td><td class="px-3 py-1.5">{{str .ip}}</td></tr>
        {{end}}{{if not .log}}<tr><td colspan="6" class="px-4 py-8 text-center font-sans text-steel">{{__ "No requests yet."}}</td></tr>{{end}}</tbody>
    </table></div>
</section>
