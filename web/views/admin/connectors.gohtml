{{- /* .clientId .hasSecret .redirect .people */ -}}
{{- $ready := and .clientId .hasSecret -}}
<div class="min-w-0"><h1 class="page-title">{{__ "Connectors"}}</h1>
    <p class="mt-1 text-sm text-steel">{{__ "Let each person connect their own Google account: Gmail and Calendar inside this system."}}</p></div>
<div class="mt-4 grid gap-4 lg:grid-cols-3">
    <form method="POST" action="{{url "/connectors"}}" class="panel lg:col-span-2">{{csrfField}}
        <div class="panel-head"><h2 class="panel-title">Google</h2><span class="badge {{if $ready}}bg-emerald-50 text-emerald-800{{else}}bg-amber-50 text-amber-800{{end}}">{{if $ready}}{{__ "Ready"}}{{else}}{{__ "Not set up"}}{{end}}</span></div>
        <div class="grid gap-4 p-5">
            <div><label class="label" for="g-id">{{__ "OAuth client ID"}}</label><input id="g-id" name="client_id" value="{{.clientId}}" class="input font-mono text-xs" autocomplete="off" placeholder="1234567890-abc.apps.googleusercontent.com"></div>
            <div><label class="label" for="g-secret">{{__ "OAuth client secret"}}</label><input id="g-secret" name="client_secret" type="password" class="input font-mono text-xs" autocomplete="new-password" placeholder="{{if .hasSecret}}•••••••• ({{__ "saved — leave empty to keep"}}){{end}}"></div>
            <div><label class="label">{{__ "Authorised redirect URI (copy this into Google Cloud)"}}</label><input readonly value="{{.redirect}}" class="input font-mono text-xs" onclick="this.select()"></div>
        </div>
        <div class="flex justify-end border-t border-graphite-900/8 bg-mist/50 px-5 py-3"><button class="btn-primary">{{__ "Save"}}</button></div>
    </form>
    <section class="panel">
        <div class="panel-head"><h2 class="panel-title">{{__ "How to set it up"}}</h2></div>
        <ol class="list-decimal space-y-2 px-8 py-4 text-sm text-steel">
            <li>{{__ "In Google Cloud Console create a project and enable the Gmail API and the Google Calendar API."}}</li>
            <li>{{__ "Create an OAuth client (type: Web application) and paste the redirect URI shown here."}}</li>
            <li>{{__ "On the consent screen add the scopes gmail.readonly, gmail.send and calendar."}}</li>
            <li>{{__ "Paste the client ID and secret here. Each person then connects under Profile → Connectors."}}</li>
            <li>{{__ "For the Google Sheets module also enable the Google Sheets API and the Google Drive API, and add the scopes spreadsheets and drive.metadata.readonly. Same client, same redirect URI."}}</li>
        </ol>
        <p class="border-t border-graphite-900/8 px-5 py-3 text-xs text-steel">{{__ "Tokens are stored encrypted. Mail is read live from Google and is not copied into this system."}}</p>
    </section>
</div>
<section class="panel mt-4 overflow-hidden">
    <div class="panel-head"><h2 class="panel-title">{{__ "Connected people"}}</h2><span class="text-xs text-steel">{{len .people}}</span></div>
    <table class="w-full text-sm"><thead class="bg-mist/60 text-left text-xs text-steel"><tr><th class="px-4 py-2 font-medium">{{__ "Person"}}</th><th class="px-3 py-2 font-medium">Google</th><th class="px-3 py-2 font-medium">{{__ "Since"}}</th><th class="px-3 py-2 font-medium">{{__ "Status"}}</th><th></th></tr></thead>
        <tbody class="divide-y divide-graphite-900/6">{{range $p := .people}}
            <tr><td class="px-4 py-2.5"><span class="font-medium">{{$p.name}}</span><span class="block text-xs text-steel">{{$p.email}}</span></td><td class="px-3 py-2.5">{{$p.google_email}}</td><td class="px-3 py-2.5 text-steel">{{timeAgo $p.connected_at}}</td>
                <td class="px-3 py-2.5">{{if $p.last_error}}<span class="text-signal-700">{{$p.last_error}}</span>{{else}}<span class="text-emerald-700">{{__ "Working"}}</span>{{end}}</td>
                <td class="px-3 py-2.5 text-right"><form method="POST" action="{{url (printf "/connectors/user/%v/disconnect" $p.user_id)}}" data-confirm="{{__ "Disconnect this person?"}}">{{csrfField}}<button class="btn-danger px-3 py-1 text-xs">{{__ "Disconnect"}}</button></form></td></tr>
        {{end}}{{if not .people}}<tr><td colspan="5" class="px-4 py-8 text-center text-steel">{{__ "Nobody has connected yet."}}</td></tr>{{end}}</tbody></table>
</section>
