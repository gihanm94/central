{{- /* .year, .q, .rows [{r, link, tone, score, calc, month, group}], .n, .done, .avg, .years */ -}}
<div class="flex flex-wrap items-end justify-between gap-4">
    <div class="min-w-0"><h1 class="page-title">{{__ "KPI calculator"}}</h1>
        <p class="mt-1 text-sm text-steel">{{__ "Yearly appraisal score out of 100 for each person. Open a person to calculate it from their KPIs, submissions and the other sections."}}</p></div>
    {{if can "kpi_calculator" "export"}}<a href="{{url "/management/kpi-calculator/export" "year" .year}}" class="btn-secondary">{{icon "download" "size-4"}}{{__ "Export"}}</a>{{end}}
</div>

<div class="mt-4 grid gap-3 sm:grid-cols-3">
    <div class="panel p-4"><p class="text-xs font-medium uppercase tracking-wide text-steel">{{__ "People"}}</p><p class="mt-1 font-display text-3xl font-semibold tabular-nums">{{.n}}</p></div>
    <div class="panel p-4"><p class="text-xs font-medium uppercase tracking-wide text-steel">{{__ "Calculated"}}</p><p class="mt-1 font-display text-3xl font-semibold tabular-nums">{{.done}} <span class="text-base text-steel">/ {{.n}}</span></p></div>
    <div class="panel p-4"><p class="text-xs font-medium uppercase tracking-wide text-steel">{{__ "Average score"}}</p><p class="mt-1 font-display text-3xl font-semibold tabular-nums">{{.avg}}</p></div>
</div>

<section class="panel mt-4 overflow-hidden">
    <form method="GET" action="{{url "/management/kpi-calculator"}}" class="flex flex-wrap items-center gap-2 border-b border-graphite-900/8 p-3">
        <div class="relative"><span class="pointer-events-none absolute inset-y-0 left-2.5 flex items-center text-graphite-400">{{icon "search" "size-4"}}</span>
            <input name="q" value="{{.q}}" class="input w-64 pl-8" placeholder="{{__ "Name or department…"}}" aria-label="{{__ "Search"}}"></div>
        <div class="w-28">{{select "year" .years .yearS "id" "kc-year" "submit" true "search" false "aria" (__ "Year")}}</div>
        <span class="ml-auto text-sm text-steel">{{__ ":n people" "n" .n}}</span>
    </form>
    <div class="overflow-x-auto"><table class="w-full text-sm">
        <thead class="whitespace-nowrap bg-mist/60 text-left text-xs text-steel"><tr>
            <th class="px-4 py-2 font-medium">{{__ "Name"}}</th><th class="px-3 py-2 font-medium">{{__ "Department"}}</th>
            <th class="px-3 py-2 font-medium">{{__ "Year"}}</th><th class="px-3 py-2 font-medium">{{__ "Month"}}</th>
            <th class="px-3 py-2 font-medium">{{__ "Group"}}</th><th class="px-3 py-2 text-right font-medium">{{__ "KPI score"}}</th>
            <th class="px-3 py-2 font-medium">{{__ "Calculated"}}</th><th class="px-3 py-2"><span class="sr-only">{{__ "Actions"}}</span></th></tr></thead>
        <tbody class="divide-y divide-graphite-900/6">
        {{range $x := .rows}}{{$r := $x.r}}
            <tr class="hover:bg-mist/40">
                <td class="px-4 py-2.5"><a href="{{$x.link}}" class="flex items-center gap-2.5 font-medium hover:text-signal-700">
                    {{template "partials/avatar" (dict "name" $r.name "avatar" $r.avatar "size" "size-8")}}
                    <span>{{$r.name}}<span class="block text-xs font-normal text-steel">{{$r.role_name}}</span></span></a></td>
                <td class="px-3 py-2.5 text-steel">{{or $r.department_name "—"}}</td>
                <td class="px-3 py-2.5 tabular-nums">{{$.year}}</td>
                <td class="px-3 py-2.5">{{if $x.month}}{{$x.month}}{{else}}<span class="text-steel">—</span>{{end}}</td>
                <td class="px-3 py-2.5 text-steel">{{$x.group}}</td>
                <td class="px-3 py-2.5 text-right"><span class="inline-flex min-w-16 justify-center rounded-md px-2 py-0.5 font-display text-lg font-semibold tabular-nums {{$x.tone}}">{{$x.score}}</span></td>
                <td class="whitespace-nowrap px-3 py-2.5 text-xs text-steel">{{$x.calc}}</td>
                <td class="px-3 py-2.5 text-right"><a href="{{$x.link}}" class="btn-secondary px-3 py-1 text-xs">{{icon "calc" "size-3.5"}}{{__ "Calculate"}}</a></td>
            </tr>
        {{end}}
        {{if not .rows}}<tr><td colspan="8" class="px-4 py-10 text-center text-steel">{{__ "No people to show."}}</td></tr>{{end}}
        </tbody>
    </table></div>
</section>
