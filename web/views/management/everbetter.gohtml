{{- /* Management → Everbetter: see ebIndex for the prepared values */ -}}
{{- $tab := .tab -}}
<div class="flex flex-wrap items-end justify-between gap-4">
    <div class="min-w-0"><h1 class="page-title">{{__ "Everbetter"}}</h1>
        <p class="mt-1 text-sm text-steel">{{__ "Improvement projects presented every quarter. Accept each request, then record the result after the presentation."}}</p></div>
    <div class="flex gap-2 text-sm">
        <span class="rounded-lg bg-amber-50 px-3 py-1.5 text-amber-900">{{__ ":n not accepted yet" "n" .waitingN}}</span>
        <span class="rounded-lg bg-sky-50 px-3 py-1.5 text-sky-900">{{__ ":n to present" "n" .acceptedN}}</span>
    </div>
</div>

<nav class="mt-6 flex gap-7 overflow-x-auto rounded-xl bg-white px-6 shadow-sm ring-1 ring-graphite-900/8" aria-label="{{__ "Everbetter"}}">
    {{range .tabs}}
        <a href="{{.url}}" {{if .on}}aria-current="page"{{end}}
           class="relative shrink-0 py-4 text-sm after:absolute after:inset-x-0 after:bottom-0 after:h-[3px] after:rounded-full {{if .on}}font-semibold text-signal-700 after:bg-signal-600{{else}}text-graphite-700 hover:text-graphite-900 after:bg-transparent{{end}}">{{.label}}</a>
    {{end}}
</nav>

{{if eq $tab "projects"}}
<section class="panel mt-4 overflow-hidden" aria-labelledby="eb-all">
    <div class="panel-head flex-wrap gap-2">
        <h2 class="panel-title" id="eb-all">{{__ "All projects"}} <span class="ml-1 text-sm font-normal text-steel">{{len .projects}}</span></h2>
        <form method="GET" action="{{url "/management/everbetter"}}" class="flex flex-wrap items-center gap-2">
            <input name="q" value="{{.pq}}" class="input !w-56" placeholder="{{__ "Project or owner"}}" aria-label="{{__ "Search"}}">
            <div class="w-44">{{select "pstatus" .stOpts .ps "placeholder" (__ "Any status") "search" false "aria" (__ "Status")}}</div>
            <button class="btn-secondary">{{__ "Show"}}</button>
        </form>
    </div>
    {{if not .projects}}<p class="px-5 py-10 text-center text-sm text-steel">{{__ "No projects yet."}}</p>{{else}}
    <div class="overflow-x-auto"><table class="w-full text-sm">
        <thead class="bg-mist/60 text-left text-xs text-steel"><tr>
            <th class="px-5 py-2 font-medium">{{__ "Project"}}</th><th class="px-3 py-2 font-medium">{{__ "Department"}}</th>
            <th class="px-3 py-2 font-medium">{{__ "Period"}}</th><th class="px-3 py-2 font-medium">{{__ "Team"}}</th>
            <th class="px-3 py-2 font-medium">{{__ "Presented"}}</th><th class="px-5 py-2 font-medium">{{__ "Status"}}</th></tr></thead>
        <tbody class="divide-y divide-graphite-900/6">
        {{range $p := .projects}}{{$last := $p.last_request}}
            <tr class="cursor-pointer hover:bg-mist/50" onclick="if (!event.target.closest('a')) location.href = this.querySelector('a').href">
                <td class="max-w-[22rem] px-5 py-3"><a href="{{url (printf "/management/everbetter/projects/%v" $p.id)}}" class="font-medium hover:text-signal-700">{{$p.title}}</a>
                    <span class="block text-xs text-steel">{{$p.owner_name}}</span></td>
                <td class="px-3 py-3 text-steel">{{or $p.department_name "—"}}</td>
                <td class="whitespace-nowrap px-3 py-3 text-steel">{{formatDate $p.start_date "d M y"}} – {{formatDate $p.end_date "d M y"}}</td>
                <td class="px-3 py-3"><div class="flex -space-x-2">{{range $p.shown}}{{template "partials/avatar" (dict "name" .name "avatar" .avatar "size" "size-7" "extra" "ring-2 ring-white")}}{{end}}
                    {{if gt $p.more 0}}<span class="flex size-7 items-center justify-center rounded-full bg-mist text-[11px] ring-2 ring-white">+{{$p.more}}</span>{{end}}</div></td>
                <td class="px-3 py-3"><span class="badge {{if gt $p.presented 0}}bg-emerald-50 text-emerald-800{{else}}bg-graphite-900/6 text-steel{{end}}">{{if gt $p.presented 0}}✓ {{__ "Presented"}}{{else}}{{__ "Not presented yet"}}{{end}}</span>
                    {{if and $last (not $last.result)}}<span class="mt-1 block text-xs text-steel">{{$p.last_kind}} · {{$p.last_label}}</span>{{end}}</td>
                <td class="px-5 py-3"><div class="flex flex-wrap gap-1">{{template "everbetter/status" (dict "p" $p)}}</div></td>
            </tr>
        {{end}}
        </tbody>
    </table></div>
    {{end}}
</section>

{{else if eq $tab "presentations"}}
<section class="panel mt-4 overflow-hidden" aria-labelledby="eb-quarter">
    <div class="panel-head">
        <h2 class="panel-title" id="eb-quarter">{{__ "This quarter (Q:q :y)" "q" .q "y" .y}}</h2>
        <span class="text-sm text-steel">{{if .session}}{{__ "Presentation day :date" "date" .sessionDay}}{{if .session.place}} · {{.session.place}}{{end}}{{else}}{{__ "No presentation day set"}}{{end}}</span>
    </div>
    {{if not .session}}
        <p class="px-5 py-8 text-center text-sm text-steel">{{__ "Set this quarter's presentation day below so people can ask to present."}}</p>
    {{else if not .thisQuarter}}
        <p class="px-5 py-8 text-center text-sm text-steel">{{__ "Nobody has asked to present this quarter yet."}}</p>
    {{else}}
    <ul class="divide-y divide-graphite-900/6">
        {{range $x := .thisQuarter}}
        <li class="flex flex-wrap items-center gap-3 px-5 py-3">
            {{template "partials/avatar" (dict "name" $x.requested_name "avatar" $x.avatar "size" "size-9")}}
            <div class="min-w-0 flex-1">
                <a href="{{url (printf "/management/everbetter/projects/%v" $x.project_id)}}" class="block truncate font-medium hover:text-signal-700">{{$x.title}}</a>
                <p class="truncate text-xs text-steel">{{$x.requested_name}}{{if $x.note}} · {{$x.note_short}}{{end}}</p>
            </div>
            <span class="badge {{$x.kind_tone}}">{{$x.kind_label}}</span>
            <span class="badge {{$x.tone}}">{{$x.state}}</span>
            {{template "management/everbetter-actions" (dict "x" $x)}}
        </li>
        {{end}}
    </ul>
    {{end}}
</section>

<section class="panel mt-4 overflow-hidden" aria-labelledby="eb-requests">
    <div class="panel-head flex-wrap gap-2">
        <h2 class="panel-title" id="eb-requests">{{__ "Presentation requests"}}</h2>
        <div class="flex flex-wrap items-center gap-2">
            <nav class="flex rounded-md bg-graphite-900/6 p-0.5 text-sm">{{range .sts}}<a href="{{.URL}}" class="rounded px-3 py-1 {{if .On}}bg-white font-medium shadow-sm{{else}}text-steel hover:text-graphite-900{{end}}">{{.Label}}</a>{{end}}</nav>
            <form method="GET" action="{{url "/management/everbetter"}}" class="w-56"><input type="hidden" name="tab" value="presentations"><input type="hidden" name="status" value="{{.status}}">
                {{select "session" .allSessions .selSession "placeholder" (__ "Every presentation day") "submit" true "search" false "aria" (__ "Presentation day")}}</form>
        </div>
    </div>
    {{if not .requests}}<p class="px-5 py-8 text-center text-sm text-steel">{{__ "Nothing here."}}</p>{{else}}
    <div class="overflow-x-auto"><table class="w-full text-sm">
        <thead class="bg-mist/60 text-left text-xs text-steel"><tr>
            <th class="px-5 py-2 font-medium">{{__ "Project"}}</th><th class="px-3 py-2 font-medium">{{__ "Presents"}}</th><th class="px-3 py-2 font-medium">{{__ "Day"}}</th>
            <th class="px-3 py-2 font-medium">{{__ "Status"}}</th><th class="px-5 py-2"><span class="sr-only">{{__ "Actions"}}</span></th></tr></thead>
        <tbody class="divide-y divide-graphite-900/6">
        {{range $x := .requests}}
            <tr class="align-top">
                <td class="max-w-[22rem] px-5 py-3"><a href="{{url (printf "/management/everbetter/projects/%v" $x.project_id)}}" class="font-medium hover:text-signal-700">{{$x.title}}</a>
                    <span class="block text-xs text-steel">{{$x.owner_name}} · {{or $x.department_name "—"}} · {{formatDate $x.start_date "d M y"}} – {{formatDate $x.end_date "d M y"}}</span>
                    {{if $x.note}}<span class="mt-1 block text-xs">{{$x.note_short}}</span>{{end}}</td>
                <td class="px-3 py-3"><span class="badge {{$x.kind_tone}}">{{$x.kind_label}}</span>
                    {{if and (eq (str $x.kind) "extension") $x.new_end_date}}<span class="mt-1 block text-xs text-steel">{{__ "to :d" "d" (formatDate $x.new_end_date)}}</span>{{end}}
                    <span class="mt-1 block text-xs text-steel">{{$x.requested_name}}</span></td>
                <td class="whitespace-nowrap px-3 py-3">{{formatDate $x.present_on "d M Y"}}<span class="block text-xs text-steel">Q{{int $x.quarter}} {{int $x.year}}</span></td>
                <td class="px-3 py-3"><span class="badge {{$x.tone}}">{{$x.state}}</span>
                    {{if $x.result_note}}<span class="mt-1 block max-w-[14rem] text-xs text-steel">{{$x.result_note}}</span>{{end}}</td>
                <td class="px-5 py-3">{{template "management/everbetter-actions" (dict "x" $x)}}</td>
            </tr>
        {{end}}
        </tbody>
    </table></div>
    {{end}}
</section>

<div class="mt-4 max-w-3xl">
    <section id="days" class="panel p-5">
        <div class="flex items-center justify-between gap-2">
            <h2 class="panel-title">{{__ "Presentation days"}}</h2>
            <div class="inline-flex items-center rounded-md bg-white ring-1 ring-graphite-900/15">
                <a href="{{.prevYear}}#days" class="btn-ghost px-2" aria-label="{{__ "Previous year"}}">{{icon "arrowleft" "size-4"}}</a>
                <span class="px-2 text-sm font-semibold tabular-nums">{{.year}}</span>
                <a href="{{.nextYear}}#days" class="btn-ghost px-2" aria-label="{{__ "Next year"}}">{{icon "right" "size-4"}}</a>
            </div>
        </div>
        <p class="mt-1 text-xs text-steel">{{__ "One day per quarter. People choose it when they ask to present."}}</p>
        <form method="POST" action="{{url "/management/everbetter/days"}}" class="mt-3 space-y-3">
            {{csrfField}}<input type="hidden" name="year" value="{{.year}}">
            {{range .qs}}
            <div class="grid grid-cols-[3rem_1fr] items-start gap-2">
                <span class="pt-2 text-sm font-semibold">Q{{.Q}}</span>
                <div class="grid gap-2 sm:grid-cols-2">
                    <div><input type="date" name="day_{{.Q}}" value="{{.Day}}" class="input" aria-label="{{__ "Q:q presentation day" "q" .Q}}"
                        min="{{.Min}}" max="{{.Max}}">{{fieldError (printf "day_%d" .Q)}}</div>
                    <input name="place_{{.Q}}" value="{{.Place}}" maxlength="200" class="input" placeholder="{{__ "Room or link (optional)"}}" aria-label="{{__ "Place"}}">
                </div>
            </div>
            {{end}}
            <div class="flex justify-end"><button class="btn-primary">{{__ "Save days"}}</button></div>
        </form>
    </section>
</div>

{{else if eq $tab "departments"}}{{$bd := .bd}}
<section class="panel mt-4 overflow-hidden">
    <div class="panel-head"><h2 class="panel-title">{{__ "Projects submitted by department"}}</h2>
        <span class="text-xs text-steel">{{__ "A project counts in the year it first asked to present."}}{{if $bd.drafts}} {{__ ":n not submitted yet." "n" $bd.drafts}}{{end}}</span></div>
    <div class="overflow-x-auto"><table class="w-full text-sm">
        <thead class="bg-mist/60 text-xs text-steel"><tr>
            <th class="px-5 py-2 text-left font-medium">{{__ "Department"}}</th>
            {{range $bd.years}}<th class="px-4 py-2 text-center font-medium {{if .this}}text-graphite-900{{end}}">{{.y}}{{if .this}} <span class="font-normal text-steel">({{__ "this year"}})</span>{{end}}</th>{{end}}
            <th class="px-5 py-2 text-right font-medium">{{__ "Total"}}</th></tr></thead>
        <tbody class="divide-y divide-graphite-900/6">
        {{range $bd.rows}}
            <tr>
                <td class="px-5 py-2.5"><span class="inline-flex items-center gap-2 font-medium"><span class="size-2.5 rounded-full" style="background: {{css .color}}"></span>{{.name}}</span></td>
                {{range .cells}}
                    <td class="px-4 py-2.5 text-center">
                        {{if .n}}
                            <span class="inline-flex min-w-10 justify-center rounded-md px-2 py-1 font-semibold tabular-nums" style="{{css .style}}">{{.n}}</span>
                            <span class="mt-0.5 block text-[11px] text-steel">{{.approved}}</span>
                        {{else}}<span class="text-graphite-300">0</span>{{end}}
                    </td>
                {{end}}
                <td class="px-5 py-2.5 text-right font-semibold tabular-nums">{{.sum}}</td>
            </tr>
        {{end}}
        </tbody>
        <tfoot class="border-t-2 border-graphite-900/10 bg-mist/40 font-semibold"><tr>
            <td class="px-5 py-2.5">{{__ "All departments"}}</td>
            {{range $bd.totals}}<td class="px-4 py-2.5 text-center tabular-nums">{{.n}}</td>{{end}}
            <td class="px-5 py-2.5 text-right tabular-nums">{{$bd.all}}</td></tr></tfoot>
    </table></div>
</section>

{{else}}{{$rk := .rk}}
<div class="mt-4 grid items-start gap-4 xl:grid-cols-5">
    <section class="panel overflow-hidden xl:col-span-3">
        <div class="panel-head"><h2 class="panel-title">{{__ "Top projects by year"}}</h2></div>
        <div class="divide-y divide-graphite-900/6">
            {{range $rk.years}}
            <div class="px-5 py-4">
                <div class="flex items-center justify-between gap-2"><h3 class="font-display text-xl font-semibold">{{.y}}</h3>
                    <a href="{{.url}}" class="text-xs text-steel hover:text-graphite-900">{{if .has}}{{__ "Change"}}{{else}}{{__ "Set the ranking"}}{{end}}</a></div>
                {{if not .has}}<p class="mt-2 text-sm text-steel">{{__ "No ranking yet."}}</p>{{else}}
                <ol class="mt-3 grid gap-2 sm:grid-cols-3">
                    {{range .places}}
                    <li class="rounded-lg p-3 ring-1 {{if .p}}{{.tone}}{{else}}bg-mist/40 ring-graphite-900/8{{end}}">
                        <p class="text-xs font-semibold text-steel"><span class="text-lg">{{.icon}}</span> {{.label}}</p>
                        {{if .p}}<a href="{{url (printf "/management/everbetter/projects/%v" .p.id)}}" class="mt-1 block font-medium leading-snug hover:text-signal-700">{{.p.title}}</a>
                            <p class="mt-0.5 text-xs text-steel">{{.sub}}</p>
                        {{else}}<p class="mt-1 text-sm text-steel">—</p>{{end}}
                    </li>
                    {{end}}
                </ol>
                {{end}}
            </div>
            {{end}}
        </div>
    </section>
    <section id="rank-form" class="panel p-5 xl:col-span-2">
        <div class="flex items-center justify-between gap-2">
            <h2 class="panel-title">{{__ "Ranking of :y" "y" $rk.year}}</h2>
            <div class="inline-flex items-center rounded-md bg-white ring-1 ring-graphite-900/15">
                <a href="{{$rk.prev}}" class="btn-ghost px-2" aria-label="{{__ "Previous year"}}">{{icon "arrowleft" "size-4"}}</a>
                <span class="px-2 text-sm font-semibold tabular-nums">{{$rk.year}}</span>
                <a href="{{$rk.next}}" class="btn-ghost px-2" aria-label="{{__ "Next year"}}">{{icon "right" "size-4"}}</a>
            </div>
        </div>
        <p class="mt-1 text-xs text-steel">{{__ "Choose from the projects that presented on one of :y's days. The teams are told." "y" $rk.year}}</p>
        {{if not $rk.hasCandidates}}<p class="mt-4 rounded-lg bg-mist px-3 py-3 text-sm text-steel">{{__ "No project presented in :y." "y" $rk.year}}</p>{{else}}
        <form method="POST" action="{{url "/management/everbetter/ranking"}}" class="mt-4 space-y-3">
            {{csrfField}}<input type="hidden" name="year" value="{{$rk.year}}">
            {{range $rk.picks}}
            <div><label class="label"><span class="text-base">{{.icon}}</span> {{.label}}</label>
                {{select (printf "rank_%d" .n) $rk.opts .cur "placeholder" (__ "Nobody") "search" true "aria" .label}}{{fieldError (printf "rank_%d" .n)}}</div>
            {{end}}
            <div class="flex justify-end"><button class="btn-primary">{{__ "Save ranking"}}</button></div>
        </form>
        {{end}}
    </section>
</div>
{{end}}

{{template "management/everbetter-decide" .}}
