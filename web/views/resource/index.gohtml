{{- $res := .c.resource -}}
{{- $q := query "q" -}}
{{- $active := 0}}{{range .filters}}{{if query .Name}}{{$active = add $active 1}}{{end}}{{end -}}
{{- $searching := or $q (gt $active 0) -}}
{{- $plural := __ (ucfirst .c.plural) -}}
{{- $singular := __ .c.singular -}}
{{- $primary := ""}}{{range .columns}}{{if and .Primary (not $primary)}}{{$primary = .Key}}{{end}}{{end}}{{if and (not $primary) .columns}}{{$primary = (index .columns 0).Key}}{{end -}}
{{- $tones := dict "amber" "bg-amber-50/70" "sky" "bg-sky-50/70" "emerald" "bg-emerald-50/70" -}}
{{- $ro := .c.readonly -}}
{{- $sel := .c.selectable -}}
{{- $hidden := .hidden -}}
{{- $c := .c -}}{{- $rowActions := .rowActions -}}{{- $sort := .sort -}}{{- $dir := .dir -}}
<div class="flex flex-wrap items-end justify-between gap-4">
    <div class="min-w-0">
        <h1 class="page-title">{{$plural}}</h1>
        <p class="mt-1 text-sm text-steel"><span data-total>{{__ ":count total" "count" .total}}{{if $searching}} · {{__ "filtered"}}{{end}}</span>{{if .intro}}. {{.intro}}{{end}}</p>
    </div>
</div>

{{if .stats}}
{{template "crm/stats" (dict "cards" .stats)}}
{{end}}

{{.topExtra}}
<section class="panel mt-4" data-table="{{$res}}" data-prefs-url="{{url "/table-prefs"}}">
    <!-- Toolbar: search + filter on the left; add, import, export, columns on the right -->
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-graphite-900/8 p-3">
        <form method="GET" id="list-form" class="flex min-w-0 flex-1 flex-wrap items-center gap-2">
            {{range $k := list "sort" "dir" "per_page"}}{{with query $k}}<input type="hidden" name="{{$k}}" value="{{.}}">{{end}}{{end}}
            {{if .canSearch}}
            <label class="relative w-full sm:w-72">
                <span class="sr-only">{{__ "Search"}}</span>
                <span class="pointer-events-none absolute inset-y-0 left-2.5 flex items-center text-graphite-400">{{icon "search" "size-4"}}</span>
                <input name="q" value="{{$q}}" type="search" placeholder="{{__ "Search (3+ letters)…"}}" class="input pl-8" autocomplete="off">
            </label>
            {{end}}
            {{if .filters}}
            <div class="relative">
                <button type="button" class="btn-secondary" data-toggle="#filter-panel" aria-expanded="false">{{icon "funnel" "size-4"}} {{__ "Filter"}}{{if $active}}<span class="ml-0.5 inline-flex size-5 items-center justify-center rounded-full bg-brand text-[11px] font-semibold text-white">{{$active}}</span>{{end}}</button>
                <div id="filter-panel" hidden class="absolute left-0 top-full z-30 mt-2 w-[min(22rem,calc(100vw-2rem))] rounded-lg bg-white p-4 shadow-xl ring-1 ring-graphite-900/10">
                    <div class="space-y-3">
                        {{range .filters}}
                            <div><label class="label !mb-1 text-xs text-steel">{{.Label}}</label>
                                {{select .Name .Options (query .Name) (dict "placeholder" .Label "aria" .Label)}}</div>
                        {{end}}
                    </div>
                    <div class="mt-4 flex justify-between gap-2">
                        <a href="{{url $c.base}}" class="btn-ghost">{{__ "Clear all"}}</a>
                        <button class="btn-dark">{{__ "Apply"}}</button>
                    </div>
                </div>
            </div>
            {{end}}
            {{if $searching}}<a href="{{url $c.base}}" class="btn-ghost">{{__ "Clear"}}</a>{{end}}
        </form>

        <div class="flex flex-wrap items-center gap-2">
            {{.headerActions}}
            {{if and (not $ro) (can $res "create")}}<a href="{{url (printf "%s/create" $c.base)}}" class="btn-primary">{{icon "plus" "size-4"}} {{__ "Add"}}</a>{{end}}
            {{if and (not $ro) $c.import}}<button type="button" class="btn-secondary" data-toggle="#import-panel" aria-expanded="false" title="{{__ "Import"}}">{{icon "upload" "size-4"}}<span class="hidden lg:inline"> {{__ "Import"}}</span></button>{{end}}
            {{if can $res "export"}}<a href="{{url (printf "%s/export" $c.base) queryMap}}" class="btn-secondary" title="{{__ "Export"}}">{{icon "download" "size-4"}}<span class="hidden lg:inline"> {{__ "Export"}}</span></a>{{end}}
            <div class="relative">
                <button type="button" class="btn-secondary" data-menu="#columns-menu" data-placement="bottom-end" aria-haspopup="menu" aria-expanded="false" title="{{__ "Choose columns"}}">{{icon "columns" "size-4"}}<span class="hidden lg:inline"> {{__ "View"}}</span></button>
                <div id="columns-menu" data-menu-panel hidden role="menu" class="fixed z-[70] w-60 rounded-lg bg-white p-2 shadow-xl ring-1 ring-graphite-900/10">
                    <p class="px-2 pb-1.5 pt-1 text-xs font-medium text-steel">{{__ "Columns to show"}}</p>
                    {{range .columns}}{{$isPrimary := eq .Key $primary}}
                    <label class="flex items-center gap-2.5 rounded-md px-2 py-1.5 text-sm hover:bg-mist {{if $isPrimary}}opacity-60{{else}}cursor-pointer{{end}}">
                        <input type="checkbox" data-col-toggle="{{.Key}}" class="size-4 accent-signal-600" {{if or $isPrimary (not (in .Key $hidden))}}checked{{end}} {{if $isPrimary}}disabled{{end}}>
                        {{.Label}}
                    </label>
                    {{end}}
                    <button type="button" data-col-reset class="mt-1 w-full rounded-md px-2 py-1.5 text-left text-xs text-steel hover:bg-mist">{{__ "Show all columns"}}</button>
                </div>
            </div>
        </div>
    </div>

    {{if and (not $ro) $c.import}}
    <form id="import-panel" hidden method="POST" action="{{url (printf "%s/import" $c.base)}}" enctype="multipart/form-data" class="flex flex-wrap items-end gap-4 border-b border-graphite-900/8 bg-mist/40 p-4">
        {{csrfField}}
        <div class="min-w-0 flex-1 basis-64">
            <label for="file" class="label">{{__ "CSV or Excel file"}}</label>
            <input id="file" name="file" type="file" accept=".csv,.xlsx,text/csv" required class="w-full text-sm file:mr-3 file:rounded-md file:border-0 file:bg-graphite-900 file:px-3 file:py-1.5 file:text-sm file:text-white">
            <p class="hint">{{__ "First row must be the column names. Drop-down columns accept the name shown in the app."}} <a href="{{url (printf "%s/template" $c.base)}}" class="font-medium text-graphite-900 underline underline-offset-2">{{__ "Download the template"}}</a></p>
        </div>
        <button class="btn-dark">{{__ "Import rows"}}</button>
    </form>
    {{end}}

    <div data-list-region>
    <!-- Phones: cards -->
    <ul class="divide-y divide-graphite-900/6 md:hidden">
        {{range $row := .rows}}{{$a := get $rowActions $row.id}}
            <li class="p-4">
                <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">{{range $.columns}}{{if eq .Key $primary}}{{call .Render ctx $row}}{{end}}{{end}}</div>
                    <div class="relative shrink-0">
                        <button type="button" class="btn-ghost px-2" data-menu="#rowm-{{$row.id}}" data-placement="bottom-end" aria-haspopup="menu" aria-expanded="false" aria-label="{{__ "Actions"}}">{{icon "dots" "size-5"}}</button>
                        {{template "resource/row-menu" (dict "c" $c "row" $row "a" $a "id" (printf "rowm-%v" $row.id) "singular" $singular)}}
                    </div>
                </div>
                <dl class="mt-3 grid grid-cols-2 gap-x-4 gap-y-2.5 text-sm">
                    {{range $.columns}}{{if ne .Key $primary}}
                        <div class="min-w-0" data-col="{{.Key}}" {{if in .Key $hidden}}hidden{{end}}><dt class="text-xs text-steel">{{.Label}}</dt><dd class="mt-0.5 min-w-0 break-words">{{call .Render ctx $row}}</dd></div>
                    {{end}}{{end}}
                </dl>
            </li>
        {{end}}
    </ul>

    {{if $sel}}
    <div data-bulk-bar hidden class="flex flex-wrap items-center gap-3 border-b border-graphite-900/8 bg-signal-50/60 px-4 py-2 text-sm">
        <span><span data-bulk-n class="font-semibold">0</span> {{__ "selected"}}</span>
        <button type="button" class="btn bg-signal-600 py-1 text-white hover:bg-signal-700" data-bulk-delete data-url="{{url (printf "%s/bulk-delete" $c.base)}}" data-kind="{{__ $c.plural}}">{{icon "trash" "size-4"}} {{__ "Delete selected"}}</button>
        <button type="button" class="btn-ghost py-1" data-bulk-clear>{{__ "Clear"}}</button>
    </div>
    {{end}}
    <!-- Tablets and up: table -->
    <div class="hidden overflow-x-auto md:block">
        <table class="table w-max min-w-full" data-table-el>
            <thead class="bg-white">
                <tr>
                    <th class="sticky left-0 z-[2] {{if $sel}}w-20{{else}}w-12{{end}} bg-white !px-2 shadow-[1px_0_0_rgba(23,24,27,.06)]">{{if $sel}}<input type="checkbox" data-sel-all class="size-4 accent-signal-600" aria-label="{{__ "Select all"}}">{{end}}<span class="sr-only">{{__ "Actions"}}</span></th>
                    {{range .columns}}
                    <th data-col="{{.Key}}" {{if and (in .Key $hidden) (ne .Key $primary)}}hidden{{end}} aria-sort="{{if eq $sort .Key}}{{if eq $dir "desc"}}descending{{else}}ascending{{end}}{{else}}none{{end}}">
                        {{if .Sort}}
                            <a href="{{url path (withQueryMap "sort" .Key "dir" (ternary (and (eq $sort .Key) (eq $dir "asc")) "desc" "asc") "page" "")}}" class="group flex items-center justify-between gap-2 whitespace-nowrap text-graphite-900 hover:text-signal-700">{{.Label}}
                                {{if eq $sort .Key}}{{icon (ternary (eq $dir "desc") "sortdown" "sortup") "size-3.5 shrink-0 text-signal-700"}}{{else}}{{icon "updown" "size-3.5 shrink-0 text-graphite-400 group-hover:text-signal-700"}}{{end}}</a>
                        {{else}}<span class="whitespace-nowrap text-graphite-900">{{.Label}}</span>{{end}}
                    </th>
                    {{end}}
                </tr>
            </thead>
            <tbody>
            {{range $row := .rows}}{{$a := get $rowActions $row.id}}
                <tr class="group hover:bg-mist/40" data-row="{{$row.id}}">
                    <td class="sticky left-0 z-[1] bg-white !px-2 shadow-[1px_0_0_rgba(23,24,27,.06)] group-hover:bg-[#f5f6f7]">
                        <div class="relative {{if $sel}}flex items-center gap-1.5{{end}}">
                            {{if $sel}}<input type="checkbox" data-sel="{{$row.id}}" class="size-4 accent-signal-600" aria-label="{{__ "Select"}}">{{end}}
                            <button type="button" class="btn-ghost size-8 px-0" data-menu="#row-{{$row.id}}" data-placement="bottom-start" aria-haspopup="menu" aria-expanded="false" aria-label="{{__ "Actions"}}">{{icon "dots" "size-5"}}</button>
                            {{template "resource/row-menu" (dict "c" $c "row" $row "a" $a "id" (printf "row-%v" $row.id) "singular" $singular)}}
                        </div>
                    </td>
                    {{range $.columns}}
                        <td data-col="{{.Key}}" class="whitespace-nowrap {{get $tones .Tone}}" {{if and (in .Key $hidden) (ne .Key $primary)}}hidden{{end}}>{{call .Render ctx $row}}</td>
                    {{end}}
                </tr>
            {{end}}
            </tbody>
        </table>
    </div>
    {{if not .rows}}
        <p class="px-5 py-14 text-center text-sm text-steel">
            {{if $searching}}{{__ "Nothing matches these filters."}}{{else}}{{__ "No :items yet." "items" (lower $plural)}}{{end}}
            {{if and (not $ro) (not $searching) (can $res "create")}}<a href="{{url (printf "%s/create" $c.base)}}" class="ml-1 font-medium text-signal-700 hover:underline">{{__ "Add the first one"}}</a>{{end}}
        </p>
    {{end}}
    {{template "partials/pagination" (dict "total" .total "perPage" .perPage "page" .page)}}
    </div>
</section>
