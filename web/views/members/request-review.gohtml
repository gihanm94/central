{{set "crumbs" (list (list (__ "Members") "/members") (list (__ "Account requests") "/members/requests"))}}
{{- $r := .r -}}
<div class="mx-auto max-w-3xl">
    <h1 class="page-title">{{__ "Account request"}}</h1>
    <p class="mt-1 text-sm text-steel">{{__ "Sent :when from :ip" "when" (formatDate $r.created_at "d M Y H:i") "ip" (coalesce $r.ip_address "—")}}</p>

    {{if ne (str $r.status) "pending"}}<p class="mt-4 rounded-lg bg-white px-4 py-3 text-sm shadow-sm ring-1 ring-graphite-900/8">{{if eq (str $r.status) "approved"}}{{__ "This request was approved."}}{{else}}{{__ "This request was rejected."}}{{end}}</p>{{else}}

    <form method="POST" action="{{url (printf "/members/requests/%v/approve" $r.id)}}" class="panel mt-5 overflow-hidden" novalidate>{{csrfField}}
        <h2 class="border-b border-graphite-900/6 bg-mist/50 px-5 py-2 text-xs font-semibold text-steel">{{__ "What the person typed (you can correct it)"}}</h2>
        <div class="grid gap-x-6 gap-y-5 p-5 sm:grid-cols-2">
            <div><label class="label" for="f-employee_code">{{__ "Employee ID"}} *</label><input id="f-employee_code" name="employee_code" value="{{old "employee_code" $r.employee_code}}" class="input" maxlength="30">{{fieldError "employee_code"}}</div>
            <div><label class="label" for="f-name">{{__ "Full name"}} *</label><input id="f-name" name="name" value="{{old "name" $r.name}}" class="input" maxlength="120">{{fieldError "name"}}</div>
            <div><label class="label" for="f-email">{{__ "Work e-mail"}} *</label><input id="f-email" type="email" name="email" value="{{old "email" $r.email}}" class="input">{{fieldError "email"}}</div>
            <div><label class="label" for="f-phone">{{__ "Phone"}}</label><input id="f-phone" name="phone" value="{{old "phone" $r.phone}}" class="input" maxlength="30">{{fieldError "phone"}}</div>
            <div><label class="label">{{__ "Gender"}}</label>{{select "gender" .genders (old "gender" $r.gender) "placeholder" (__ "Choose…") "class" "input"}}</div>
            <div><span class="label">{{__ "Department they typed"}}</span><p class="rounded-md bg-amber-50 px-3 py-2 text-sm font-medium text-amber-900">{{or $r.department_text "—"}}</p></div>
        </div>
        <h2 class="border-y border-graphite-900/6 bg-mist/50 px-5 py-2 text-xs font-semibold text-steel">{{__ "What you decide"}}</h2>
        <div class="grid gap-x-6 gap-y-5 p-5 sm:grid-cols-2">
            <div><label class="label">{{__ "Department"}} *</label>{{select "department_id" .departments (old "department_id" .guess) "placeholder" (__ "Choose the department…") "class" "input"}}{{fieldError "department_id"}}</div>
            <div><label class="label">{{__ "Role"}} *</label>{{select "role_id" .roles (old "role_id" "") "placeholder" (__ "Choose the role…") "class" "input"}}{{fieldError "role_id"}}</div>
            <div><label class="label">{{__ "Team"}}</label>{{select "team_id" .teams (old "team_id" "") "placeholder" (__ "No team") "class" "input"}}{{fieldError "team_id"}}</div>
            <div><label class="label">{{__ "Reports to"}}</label>{{select "manager_id" .people (old "manager_id" "") "placeholder" (__ "Nobody") "class" "input"}}</div>
            <div class="sm:col-span-2"><label class="label" for="f-job">{{__ "Job title"}}</label><input id="f-job" name="job_title" value="{{old "job_title" ""}}" class="input" maxlength="120"></div>
        </div>
        <p class="mx-5 mb-5 flex items-center gap-2 rounded-md bg-emerald-50 px-3 py-2 text-sm text-emerald-900">{{icon "shield" "size-4"}} {{__ "The password they chose is kept as a hash and becomes their password. Nobody, including you, can read it."}}</p>
        <div class="flex flex-wrap items-center justify-between gap-3 border-t border-graphite-900/8 bg-mist/40 px-5 py-3">
            <a href="{{url "/members/requests"}}" class="btn-ghost">{{__ "Back"}}</a>
            <div class="flex gap-2"><button type="button" class="btn-danger" data-toggle="#reject-box" aria-expanded="false">{{__ "Reject"}}</button><button class="btn-primary">{{icon "check" "size-4"}} {{__ "Approve and create the member"}}</button></div>
        </div>
    </form>

    <form id="reject-box" hidden method="POST" action="{{url (printf "/members/requests/%v/reject" $r.id)}}" class="panel mt-4 space-y-3 p-5">{{csrfField}}
        <label class="label" for="f-reason">{{__ "Reason (sent to the person, optional)"}}</label><input id="f-reason" name="reason" maxlength="300" class="input">
        <button class="btn-danger">{{__ "Reject the request"}}</button>
    </form>
    {{end}}
</div>
