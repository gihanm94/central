<span class="flex min-w-0 items-center gap-2.5">{{if .Img}}<img src="{{.Img}}" alt="" class="size-8 shrink-0 rounded bg-white object-contain ring-1 ring-graphite-900/10">{{else}}<span class="inline-flex size-8 shrink-0 items-center justify-center rounded bg-graphite-900/6 text-[11px] font-semibold text-graphite-700">{{initials .Label}}</span>{{end}}<span class="min-w-0 text-left"><span class="block truncate leading-tight">{{.Label}}</span>{{if .Sub}}<span class="block truncate text-xs leading-tight text-steel">{{.Sub}}</span>{{end}}</span></span>
