{{if .on}}<a href="{{.href}}" class="inline-flex size-8 items-center justify-center rounded-md ring-1 ring-graphite-900/15 bg-white hover:bg-mist" aria-label="{{.label}}" title="{{.label}}">{{.glyph}}</a>{{else}}<span class="inline-flex size-8 items-center justify-center rounded-md ring-1 ring-graphite-900/15 cursor-not-allowed bg-mist/60 text-graphite-400" aria-disabled="true" aria-label="{{.label}}">{{.glyph}}</span>{{end}}
