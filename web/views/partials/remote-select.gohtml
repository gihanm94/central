{{- /* Dropdown whose options are fetched from the server while you search and scroll (ui.js).
   .name .value .current (M label sub img) .kind (leads|contacts|opportunities) .o: placeholder id required depends aria */ -}}
{{- $id := or .o.id (printf "rs-%s" .name) -}}
{{- $ph := or .o.placeholder (__ "Choose…") -}}
{{- $has := and .value .current -}}
<div class="relative" data-select data-remote-select data-url="{{url (printf "/crm/search/%s" .kind)}}" data-placeholder="{{$ph}}" data-msg-loading="{{__ "Loading…"}}" data-msg-none="{{__ "No matches"}}" data-msg-error="{{__ "Could not load. Try again."}}" {{with .o.depends}}data-depends="{{.}}"{{end}}>
    <input type="hidden" name="{{.name}}" value="{{.value}}" data-select-input>
    <button type="button" id="{{$id}}" data-select-button data-base="input h-auto min-h-8 py-1" aria-haspopup="listbox" aria-expanded="false" {{with .o.aria}}aria-label="{{.}}"{{end}}
            class="input flex h-auto min-h-8 w-full items-center justify-between gap-2 py-1 text-left">
        <span data-select-label class="min-w-0 flex-1 truncate {{if not $has}}text-graphite-400{{end}}">{{if $has}}
            <span class="flex min-w-0 items-center gap-2.5">{{if .current.img}}<img src="{{.current.img}}" alt="" class="size-8 shrink-0 rounded bg-white object-contain ring-1 ring-graphite-900/10">{{else}}<span class="inline-flex size-8 shrink-0 items-center justify-center rounded bg-graphite-900/6 text-[11px] font-semibold text-graphite-700">{{initials .current.label}}</span>{{end}}<span class="min-w-0 text-left"><span class="block truncate leading-tight">{{.current.label}}</span>{{if .current.sub}}<span class="block truncate text-xs leading-tight text-steel">{{.current.sub}}</span>{{end}}</span></span>
        {{else}}{{$ph}}{{end}}</span>
        {{icon "updown" "size-4 shrink-0 opacity-60"}}
    </button>
    <div data-select-panel data-remote hidden role="listbox" aria-labelledby="{{$id}}" class="fixed z-[70] min-w-[min(30rem,92vw)] rounded-lg bg-white p-1 text-graphite-900 shadow-xl ring-1 ring-graphite-900/10">
        <div class="p-1"><input type="text" data-select-search placeholder="{{__ "Search…"}}" class="w-full rounded-md border-0 bg-mist px-2.5 py-1.5 text-sm ring-0 focus:outline-none focus:ring-2 focus:ring-signal-600" autocomplete="off"></div>
        <div class="max-h-72 overflow-y-auto" data-select-list>
            {{if not .o.required}}
            <button type="button" role="option" data-value="" data-label="{{$ph}}" aria-selected="{{if $has}}false{{else}}true{{end}}" class="flex w-full items-center rounded-md px-2.5 py-1.5 text-left text-sm text-steel hover:bg-mist focus:bg-mist focus:outline-none">{{$ph}}</button>
            {{end}}
            <div data-remote-items></div>
            <p data-remote-status class="px-2.5 py-2 text-sm text-steel"></p>
        </div>
    </div>
</div>
