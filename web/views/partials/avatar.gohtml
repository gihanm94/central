{{- $size := or .size "size-9" -}}{{- $extra := or .extra "" -}}
{{if .avatar}}
<img src="{{uploadURL .avatar}}" alt="" class="{{$size}} {{$extra}} shrink-0 rounded-full object-cover">
{{else}}
<span class="{{$size}} {{$extra}} inline-flex shrink-0 items-center justify-center rounded-full bg-graphite-700 text-xs font-semibold text-white">{{initials (or .name "?")}}</span>
{{end}}
