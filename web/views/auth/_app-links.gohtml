{{- /* "Get the mobile app" badges of the sign-in page; the administrator picks the stores and top or bottom in Settings. */ -}}
{{define "auth/app-links"}}
<div style="{{css .style}}" data-app-links>
    <p class="mb-2 text-xs text-graphite-400">{{__ "Prefer the mobile app?"}}</p>
    <div class="flex flex-wrap items-center gap-3">
        {{with .b.app_ios}}<a href="{{.}}" target="_blank" rel="noopener noreferrer" data-app-ios class="inline-block rounded-lg transition hover:opacity-90" title="{{__ "iPhone app"}}"><img src="{{asset "assets/app-store-badge.svg"}}" alt="{{__ "Download on the App Store"}}" style="height:44px;width:auto" height="44"></a>{{end}}
        {{with .b.app_android}}<a href="{{.}}" target="_blank" rel="noopener noreferrer" data-app-android class="inline-block rounded-lg transition hover:opacity-90" title="{{__ "Android app"}}"><img src="{{asset "assets/google-play-badge.svg"}}" alt="{{__ "Get it on Google Play"}}" style="height:44px;width:auto" height="44"></a>{{end}}
    </div>
</div>
{{end}}
