{{set "layout" "layouts/guest"}}
<h1 class="font-display text-4xl font-semibold tracking-tight">{{__ "Choose a new password"}}</h1>
<p class="mt-2 text-sm text-graphite-400">{{__ "At least 8 characters, with upper and lower case letters and a number."}}</p>
<form method="POST" action="{{url "/reset-password"}}" class="mt-8 space-y-5">
    {{csrfField}}
    <input type="hidden" name="token" value="{{old "token" .token}}">
    {{range list (list "email" (__ "Work e-mail") "email" "username" (old "email" $.email)) (list "password" (__ "New password") "password" "new-password" "") (list "password_confirmation" (__ "Confirm new password") "password" "new-password" "")}}
        <div>
            <label for="{{index . 0}}" class="mb-1.5 block text-sm font-medium text-graphite-300">{{index . 1}}</label>
            <input id="{{index . 0}}" name="{{index . 0}}" type="{{index . 2}}" value="{{index . 4}}" required autocomplete="{{index . 3}}" class="input-dark">
            {{with errorFor (index . 0)}}<p class="mt-1.5 text-xs font-medium text-signal-500">{{.}}</p>{{end}}
        </div>
    {{end}}
    <button type="submit" class="btn-primary w-full py-2.5">{{__ "Save password"}}</button>
</form>
