{{set "layout" "layouts/guest"}}
<a href="{{url "/login"}}" class="text-sm text-graphite-400 hover:text-white">&larr; {{__ "Back to sign in"}}</a>
<h1 class="mt-6 font-display text-4xl font-semibold tracking-tight">{{__ "Reset your password"}}</h1>
<p class="mt-2 text-sm text-graphite-400">{{__ "Enter your work e-mail. We'll send a link to choose a new password."}}</p>
{{template "auth/_messages" .}}
<form method="POST" action="{{url "/forgot-password"}}" class="mt-8 space-y-5">
    {{csrfField}}
    <div>
        <label for="email" class="mb-1.5 block text-sm font-medium text-graphite-300">{{__ "Work e-mail"}}</label>
        <input id="email" name="email" type="email" value="{{old "email"}}" required autofocus autocomplete="email" inputmode="email" class="input-dark">
        {{with errorFor "email"}}<p class="mt-1.5 text-xs font-medium text-signal-500">{{.}}</p>{{end}}
    </div>
    <button type="submit" class="btn-primary w-full py-2.5">{{__ "Send reset link"}}</button>
</form>
