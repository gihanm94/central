{{- /* .r record, .m machine, .items, .people, .by, .person, .mstat */ -}}
{{- set "crumbs" (list (list (__ "Maintenance") "/machines/maintenance")) -}}
{{- $r := .r -}}{{- $m := .m -}}
<form method="POST" action="{{url (printf "/machines/maintenance/%v/perform" $r.id)}}" enctype="multipart/form-data" data-no-busy data-check class="mx-auto max-w-2xl pb-28">
    {{csrfField}}
    <section class="panel overflow-hidden">
        <div class="p-4">
            <p class="text-xs tabular-nums text-steel">{{$m.machine_code}} · {{__ "round :n of :y" "n" (coalesce $r.round "?") "y" $r.years}}</p>
            <h1 class="text-lg font-semibold leading-tight">{{$m.machine_name}}</h1>
            <p class="mt-1.5 flex flex-wrap items-center gap-2 text-sm text-steel">{{__ "Due"}} <strong class="text-graphite-900">{{if $r.due_date}}{{formatDate $r.due_date}}{{else}}—{{end}}</strong> {{if .late}}<span class="inline-flex items-center whitespace-nowrap rounded-full px-2 py-0.5 text-xs font-medium ring-1 ring-inset bg-red-50 text-red-800 ring-red-600/20">{{__ "Overdue"}}</span>{{end}}</p>
        </div>
    </section>

    <section class="panel mt-4 space-y-4 p-4">
        <div class="grid gap-4 sm:grid-cols-2">
            <div><label class="label" for="f-date">{{__ "Date done"}}</label><input id="f-date" type="date" name="actual_date" value="{{old "actual_date" .today}}" max="{{.today}}" class="input !h-11">{{fieldError "actual_date"}}</div>
            <div><label class="label">{{__ "Done by"}}</label>{{select "maintenance_by" .byOpts .by (dict "search" false "class" "input !h-11")}}{{fieldError "maintenance_by"}}</div>
            <div class="sm:col-span-2"><label class="label">{{__ "Person doing the maintenance"}}</label>{{select "responsible_maintenance" .people .person (dict "class" "input !h-11")}}</div>
        </div>
        <div>
            <span class="label">{{__ "Machine status after the maintenance"}}</span>
            <div class="grid grid-cols-2 gap-2" role="radiogroup">
                {{range .statusChoices}}
                <label class="cursor-pointer"><input type="radio" name="machine_status" value="{{.Value}}" class="peer sr-only" {{if eq $.mstat .Value}}checked{{end}}>
                    <span class="flex h-12 items-center justify-center rounded-xl bg-white px-2 text-sm font-semibold ring-1 ring-graphite-900/15 transition-colors peer-focus-visible:outline-2 peer-focus-visible:outline-signal-600 {{.Class}}">{{.Label}}</span></label>
                {{end}}
            </div>
            {{fieldError "machine_status"}}
        </div>
    </section>

    {{if .items}}
    <h2 class="mb-2 mt-6 flex items-center justify-between text-sm font-semibold"><span>{{__ "Maintenance checklist"}}</span><span class="text-xs font-normal text-steel" data-progress>{{len .items}}</span></h2>
    {{with errorFor "answers"}}<p class="mb-2 rounded-lg bg-red-50 px-3 py-2 text-sm text-red-800">{{.}}</p>{{end}}
    {{template "machines/_questions" (dict "items" .items)}}
    {{end}}

    <section class="panel mt-5 space-y-4 p-4">
        <div><label class="label" for="f-job">{{__ "What was done"}} <span class="text-signal-600">*</span></label><textarea id="f-job" name="job_detail" rows="4" maxlength="3000" class="input">{{old "job_detail" ""}}</textarea>{{fieldError "job_detail"}}</div>
        <div><label class="label" for="f-note">{{__ "Note (optional)"}}</label><textarea id="f-note" name="note" rows="2" maxlength="2000" class="input">{{old "note" (coalesce $r.note "")}}</textarea></div>
        <div><label class="label" for="f-photo">{{__ "Photo (optional)"}}</label><input id="f-photo" name="image" type="file" accept="image/*" capture="environment" class="w-full text-sm file:mr-3 file:rounded-md file:border-0 file:bg-graphite-900 file:px-3 file:py-2 file:text-sm file:text-white"></div>
        <div><label class="label" for="f-docs">{{__ "Reports or certificates (optional)"}}</label><input id="f-docs" name="docs[]" type="file" multiple class="w-full text-sm file:mr-3 file:rounded-md file:border-0 file:bg-graphite-900 file:px-3 file:py-2 file:text-sm file:text-white"></div>
    </section>

    <div class="fixed inset-x-0 bottom-0 z-30 border-t border-graphite-900/10 bg-white/95 px-4 py-3 backdrop-blur lg:left-64">
        <div class="mx-auto flex max-w-2xl items-center gap-3">
            <a href="{{url "/machines/maintenance"}}" class="btn-secondary">{{__ "Cancel"}}</a>
            <button class="btn-primary !h-11 flex-1 text-base">{{icon "check" "size-5"}} {{__ "Save maintenance"}}</button>
        </div>
    </div>
</form>
<script src="{{asset "assets/machines.js"}}" defer></script>
