{{- $nav := nav -}}
<!DOCTYPE html>
<html lang="{{locale}}" class="h-full" data-sidebar="{{if $nav.collapsed}}collapsed{{else}}open{{end}}" style="font-size: {{auth.UIScale}}%">
<head>{{template "layouts/head" .}}</head>
<body class="h-full">
<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-3 focus:py-2">{{__ "Skip to content"}}</a>

<!-- Mobile drawer -->
<div id="sidebar-drawer" data-drawer hidden class="fixed inset-0 z-50 lg:hidden">
    <div class="absolute inset-0 bg-graphite-950/60" data-close-drawer></div>
    <aside class="drawer-panel relative h-full w-[18rem] max-w-[85vw] shadow-2xl">{{template "layouts/sidebar" (dict "nav" $nav "sid" "mobile" "branding" .branding)}}</aside>
</div>
<!-- Desktop sidebar (collapsible) -->
<aside class="fixed inset-y-0 left-0 z-30 hidden w-64 transition-[width] duration-200 lg:block lg:collapsed:w-[4.5rem]">{{template "layouts/sidebar" (dict "nav" $nav "sid" "desktop" "branding" .branding)}}</aside>

<div class="flex min-h-full flex-col transition-[padding] duration-200 lg:pl-64 lg:collapsed:pl-[4.5rem]">
    {{template "layouts/navbar" (dict "nav" $nav "title" .title "crumbs" .crumbs)}}
    <main id="main" class="flex-1 px-4 pb-10 pt-5 sm:px-6 sm:pb-8 lg:px-8 lg:pt-6">
        {{if debugBanner}}
            <p class="mb-4 rounded-md border-l-4 border-signal-600 bg-signal-50 px-4 py-3 text-sm text-signal-800">{{__ "This server runs in debug mode: visitors can see error details and the mobile API accepts plain HTTP. Set 'env' => 'production' in config/config.php."}}</p>
        {{end}}
        {{template "partials/flash" .}}
        {{.content}}
    </main>
    {{template "layouts/footer" .}}
</div>
{{template "partials/delete-dialog" .}}
</body>
</html>
