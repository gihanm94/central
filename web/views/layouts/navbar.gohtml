{{- $nav := .nav -}}
<header class="sticky top-0 z-20 flex h-14 items-center gap-2 border-b border-graphite-900/8 bg-white px-3 sm:h-16 sm:gap-3 sm:px-6 lg:px-8">
    <button type="button" data-sidebar-toggle class="btn-ghost -ml-1 shrink-0 px-2" aria-label="{{__ "Toggle sidebar"}}" title="{{__ "Toggle sidebar"}}">
        {{icon "panel"}}
    </button>
    <span class="h-5 w-px shrink-0 bg-graphite-900/15" aria-hidden="true"></span>

    <nav class="flex min-w-0 flex-1 items-center gap-1.5 text-sm" aria-label="{{__ "Breadcrumb"}}">
        <a href="{{url $nav.module.Home}}" class="hidden shrink-0 text-steel hover:text-graphite-900 sm:inline">{{__ $nav.module.Name}}</a>
        {{range .crumbs}}
            {{icon "right" "hidden size-3.5 shrink-0 text-graphite-400 sm:block"}}
            <a href="{{url (index . 1)}}" class="hidden shrink-0 text-steel hover:text-graphite-900 md:inline">{{index . 0}}</a>
        {{end}}
        {{if .title}}
            {{icon "right" "hidden size-3.5 shrink-0 text-graphite-400 sm:block"}}
            <span class="truncate font-medium text-graphite-900" aria-current="page">{{.title}}</span>
        {{end}}
    </nav>

    <!-- Notifications -->
    <div class="relative shrink-0">
        <button type="button" data-menu="#notif-menu" data-placement="bottom-end" aria-haspopup="menu" aria-expanded="false" class="btn-ghost relative px-2" title="{{__ "Notifications"}}" aria-label="{{__ "Notifications"}}">
            {{icon "bell" "size-[19px]"}}
            <span data-bell-badge class="absolute -right-0.5 -top-0.5 min-w-4 rounded-full bg-brand px-1 text-center text-[10px] font-semibold leading-4 text-white" {{if not $nav.unread}}hidden{{end}}>{{$nav.badge}}</span>
        </button>
        <div id="notif-menu" data-feed-url="{{url "/notifications/feed"}}" data-read-url="{{url "/notifications/read-all"}}" data-menu-panel hidden role="menu" class="fixed z-[70] w-[min(24rem,calc(100vw-1rem))] overflow-hidden rounded-lg bg-white shadow-xl ring-1 ring-graphite-900/10">
            <div class="flex items-center justify-between border-b border-graphite-900/8 px-4 py-2.5">
                <p class="text-sm font-semibold">{{__ "Notifications"}}</p>
                <button type="button" class="text-xs text-steel hover:text-graphite-900" data-bell-read>{{__ "Mark all as read"}}</button>
            </div>
            <div class="max-h-[min(26rem,70vh)] overflow-y-auto" data-bell-list>{{template "partials/notification-list" (dict "items" $nav.latest)}}</div>
            <a href="{{url "/notifications"}}" class="block border-t border-graphite-900/8 px-4 py-2.5 text-center text-sm font-medium hover:bg-mist/60">{{__ "See all notifications"}}</a>
        </div>
    </div>

    <!-- Display size -->
    <div class="relative hidden shrink-0 sm:block">
        <button type="button" data-menu="#scale-menu" data-placement="bottom-end" aria-haspopup="menu" aria-expanded="false" class="btn-ghost gap-1.5 px-2 text-xs font-semibold" title="{{__ "Display size"}}">
            {{icon "zoom" "size-[18px]"}}<span class="hidden md:inline tabular-nums" data-scale-label>{{auth.UIScale}}%</span>
        </button>
        <div id="scale-menu" data-url="{{url "/profile/scale"}}" data-menu-panel hidden role="menu" class="fixed z-[70] w-60 rounded-lg bg-white p-3 shadow-xl ring-1 ring-graphite-900/10">
            <p class="text-sm font-medium">{{__ "Display size"}}</p>
            <p class="mt-0.5 text-xs text-steel">{{__ "Make everything smaller or larger. Saved for you."}}</p>
            <div class="mt-3 grid grid-cols-5 gap-1" role="group" aria-label="{{__ "Display size"}}">
                {{range list 80 90 100 110 125}}
                    <button type="button" data-scale="{{.}}" class="h-8 rounded-md text-xs font-medium ring-1 ring-graphite-900/15 hover:bg-mist {{if eq auth.UIScale .}}bg-graphite-900 text-white ring-graphite-900 hover:bg-graphite-900{{end}}">{{.}}%</button>
                {{end}}
            </div>
            <p class="mt-2 text-xs text-steel"><kbd class="rounded bg-mist px-1">Ctrl</kbd> + <kbd class="rounded bg-mist px-1">+</kbd> / <kbd class="rounded bg-mist px-1">−</kbd> {{__ "also works in your browser."}}</p>
        </div>
    </div>

    <!-- Language -->
    <div class="relative shrink-0">
        <button type="button" data-menu="#lang-menu" data-placement="bottom-end" aria-haspopup="menu" aria-expanded="false" class="btn-ghost gap-1.5 px-2 text-xs font-semibold uppercase" title="{{__ "Language"}}">
            {{icon "globe" "size-[18px]"}}<span class="hidden sm:inline">{{locale}}</span>
        </button>
        <div id="lang-menu" data-menu-panel hidden role="menu" class="fixed z-[70] w-44 rounded-lg bg-white p-1.5 shadow-xl ring-1 ring-graphite-900/10">
            {{range locales}}
                <a role="menuitem" href="{{url (printf "/lang/%s" .Key)}}" class="flex items-center justify-between rounded-md px-2.5 py-1.5 text-sm hover:bg-mist {{if eq .Key locale}}font-medium{{end}}">
                    {{.Label}}{{if eq .Key locale}}{{icon "tick" "size-4 text-signal-600"}}{{end}}
                </a>
            {{end}}
        </div>
    </div>

    <!-- Account -->
    <div class="relative shrink-0">
        <button type="button" data-menu="#user-menu" data-placement="bottom-end" aria-expanded="false" aria-haspopup="menu" class="flex items-center gap-2 rounded-full p-0.5 pr-1 hover:bg-graphite-900/5 sm:pr-2">
            {{template "partials/avatar" (dict "name" auth.Name "avatar" auth.Avatar "size" "size-8")}}
            <span class="hidden max-w-32 truncate text-sm font-medium md:block">{{auth.FirstName}}</span>
        </button>
        <div id="user-menu" data-menu-panel hidden role="menu" class="fixed z-[70] w-64 rounded-lg bg-white p-1.5 shadow-xl ring-1 ring-graphite-900/10">
            <div class="border-b border-graphite-900/8 px-3 pb-2.5 pt-1.5">
                <p class="truncate text-sm font-medium">{{auth.Name}}</p>
                <p class="truncate text-xs text-steel">{{auth.Email}}</p>
            </div>
            {{range list (strs "/profile" "user" "Profile") (strs "/profile/security" "lock" "Security") (strs "/profile/preferences" "sliders" "Preferences") (strs "/profile/notifications" "bell" "My notifications")}}
                <a role="menuitem" href="{{url (index . 0)}}" class="mt-0.5 flex items-center gap-2.5 rounded-md px-3 py-2 text-sm hover:bg-mist">{{icon (index . 1) "size-4 text-steel"}} {{__ (index . 2)}}</a>
            {{end}}
            <form method="POST" action="{{url "/logout"}}" class="mt-1 border-t border-graphite-900/8 pt-1">
                {{csrfField}}
                <button class="flex w-full items-center gap-2.5 rounded-md px-3 py-2 text-sm text-signal-700 hover:bg-signal-50">{{icon "logout" "size-4"}} {{__ "Sign out"}}</button>
            </form>
        </div>
    </div>
</header>
