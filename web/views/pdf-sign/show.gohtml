{{- /* .row (pdf_signatures + avatar, department_name), .back [label, url], .audit (opened from a log), .signs, .byPage, .signedSize, .originalSize */ -}}
{{- set "crumbs" (list (list (index .back 0) (index .back 1))) -}}
{{- $row := .row -}}
{{- $orig := url (printf "/sign-pdf/%v/file/original" $row.id) -}}{{- $signed := url (printf "/sign-pdf/%v/file/signed" $row.id) -}}
<div class="flex flex-wrap items-start justify-between gap-4">
    <div class="min-w-0"><h1 class="page-title break-words">{{$row.title}}</h1>
        <p class="mt-1 text-sm text-steel">{{__ "Signed by :name on :date" "name" $row.user_name "date" (formatDate $row.created_at "d M Y, H:i")}}</p></div>
    <div class="flex w-full flex-wrap gap-2 sm:w-auto">
        <a href="{{$orig}}?download=1" class="btn-secondary flex-1 sm:flex-none">{{icon "download" "size-4"}} {{__ "Original"}}</a>
        <a href="{{$signed}}?download=1" class="btn-primary flex-1 sm:flex-none">{{icon "download" "size-4"}} {{__ "Signed PDF"}}</a>
    </div>
</div>

<div class="mt-6 grid items-start gap-6 xl:grid-cols-3">
    <section class="panel overflow-hidden xl:col-span-2">
        <div class="panel-head"><h2 class="panel-title">{{__ "Preview"}}</h2><a href="{{$signed}}" target="_blank" rel="noopener" class="text-sm text-steel hover:text-graphite-900">{{__ "Open in a new tab"}} ↗</a></div>
        <div class="h-[75vh] space-y-4 overflow-y-auto bg-graphite-900/5 p-4" data-pdf-preview="{{$signed}}" data-worker="{{asset "assets/vendor/pdfjs/pdf.worker.min.js"}}"
             data-l-failed="{{__ "The preview could not be shown. Download the PDF to open it."}}" role="document" aria-label="{{__ "Signed PDF"}}">
            <p data-pdf-status class="py-10 text-center text-sm text-steel">{{__ "Loading the preview…"}}</p>
        </div>
    </section>
    <section class="panel overflow-hidden">
        <div class="panel-head"><h2 class="panel-title">{{__ "Signing record"}}</h2></div>
        <dl class="divide-y divide-graphite-900/6 text-sm">
            <div class="flex items-center gap-3 px-5 py-3">{{template "partials/avatar" (dict "name" $row.user_name "avatar" $row.avatar "size" "size-9")}}
                <div class="min-w-0"><dt class="sr-only">{{__ "Signed by"}}</dt><dd class="truncate font-medium">{{$row.user_name}}{{if not $row.user_id}} <span class="text-xs text-steel">({{__ "deleted user"}})</span>{{end}}</dd>
                    <dd class="truncate text-xs text-steel">{{or $row.department_name "—"}}</dd></div></div>
            <div class="px-5 py-3"><dt class="text-xs text-steel">{{__ "Signed"}}</dt><dd class="mt-0.5 font-medium">{{formatDate $row.created_at "l d M Y, H:i:s"}}</dd></div>
            <div class="px-5 py-3"><dt class="text-xs text-steel">{{__ "Signatures"}}</dt>
                <dd class="mt-0.5 font-medium">{{.signs}} · {{.byPage}}</dd></div>
            <div class="px-5 py-3"><dt class="text-xs text-steel">{{__ "Pages"}}</dt><dd class="mt-0.5 font-medium">{{int $row.pages}}</dd></div>
            <div class="px-5 py-3"><dt class="text-xs text-steel">{{__ "Signed copy fingerprint (SHA-256)"}}</dt><dd class="mt-0.5 break-all font-mono text-xs">{{$row.signed_sha256}}</dd>
                <dd class="mt-0.5 text-xs text-steel">{{.signedSize}}</dd></div>
            <div class="px-5 py-3"><dt class="text-xs text-steel">{{__ "Original fingerprint (SHA-256)"}}</dt><dd class="mt-0.5 break-all font-mono text-xs">{{$row.original_sha256}}</dd>
                <dd class="mt-0.5 text-xs text-steel">{{.originalSize}}</dd></div>
            {{if .audit}}
            <div class="px-5 py-3"><dt class="text-xs text-steel">{{__ "From"}}</dt><dd class="mt-0.5 text-xs">{{or $row.ip_address "—"}} · {{str $row.user_agent}}</dd></div>
            {{end}}
        </dl>
    </section>
</div>
<script src="{{asset "assets/vendor/pdfjs/pdf.min.js"}}"></script>
<script src="{{asset "assets/pdfview.js"}}"></script>
