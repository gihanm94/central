{{- $canEdit := can "settings" "edit" -}}
{{template "settings/_tabs" .}}
<form method="POST" action="{{url "/settings/notifications"}}" class="mt-6 space-y-6">
    {{csrfField}}
    <fieldset {{if not $canEdit}}disabled{{end}} class="space-y-6">
        <section class="panel">
            <div class="panel-head"><div><h2 class="panel-title flex items-center gap-2">{{icon "chat" "size-4 text-signal-600"}}Lark</h2><p class="text-xs text-steel">{{__ "Send notifications to Lark as well as e-mail."}}</p></div></div>
            <div class="grid gap-5 p-4 sm:grid-cols-2 sm:p-5">
                <div>
                    <label for="lark_mode" class="label">{{__ "How to send"}}</label>
                    {{select "lark_mode" .modes (old "lark_mode" .lark.mode) (dict "id" "lark_mode" "required" true)}}
                    {{fieldError "lark_mode"}}
                </div>
                <div>
                    <label for="lark_domain" class="label">{{__ "Lark region"}}</label>
                    {{select "lark_domain" .domains (old "lark_domain" .lark.domain) (dict "id" "lark_domain" "required" true)}}
                </div>
                <div class="grid gap-5 sm:col-span-2 sm:grid-cols-2" data-show-when="lark_mode=webhook" {{if ne .lark.mode "webhook"}}hidden{{end}}>
                    <div class="sm:col-span-2">
                        <label for="lark_webhook_url" class="label">{{__ "Bot webhook address"}}</label>
                        <input id="lark_webhook_url" name="lark_webhook_url" value="{{old "lark_webhook_url" .lark.webhook}}" placeholder="https://open.larksuite.com/open-apis/bot/v2/hook/…" class="input">
                        <p class="hint">{{__ "In the Lark group: Settings → Bots → Add bot → Custom bot, then copy the webhook address."}}</p>
                        {{fieldError "lark_webhook_url"}}
                    </div>
                    <div>
                        <label for="lark_webhook_secret" class="label">{{__ "Signature secret"}} <span class="font-normal text-steel">({{__ "optional"}})</span></label>
                        <input id="lark_webhook_secret" name="lark_webhook_secret" type="password" value="{{.lark.secret}}" autocomplete="off" class="input">
                        <p class="hint">{{__ "Only if “Set signature verification” is on for the bot."}}</p>
                    </div>
                </div>
                <div class="grid gap-5 sm:col-span-2 sm:grid-cols-2" data-show-when="lark_mode=app" {{if ne .lark.mode "app"}}hidden{{end}}>
                    <div>
                        <label for="lark_app_id" class="label">{{__ "App ID"}}</label>
                        <input id="lark_app_id" name="lark_app_id" value="{{old "lark_app_id" .lark.app_id}}" placeholder="cli_…" autocomplete="off" class="input">
                        {{fieldError "lark_app_id"}}
                    </div>
                    <div>
                        <label for="lark_app_secret" class="label">{{__ "App secret"}}</label>
                        <input id="lark_app_secret" name="lark_app_secret" type="password" value="{{.lark.app_secret}}" autocomplete="off" class="input">
                    </div>
                    <p class="hint sm:col-span-2">{{__ "Create an app in the Lark developer console, enable the bot, add the permissions im:message:send_as_bot and contact:user.email:readonly, and publish it. People are matched by their work e-mail."}}</p>
                </div>
            </div>
        </section>

        <section class="panel overflow-hidden">
            <div class="panel-head"><div><h2 class="panel-title">{{__ "What sends a notification"}}</h2><p class="text-xs text-steel">{{__ "Per module. The person who acted and the record owner are told. Each person can still turn things off for themselves."}}</p></div>
                {{if $canEdit}}<div class="hidden gap-1 sm:flex"><button type="button" class="btn-ghost text-xs" data-check-all="#notify-matrix" data-value="1">{{__ "Tick all"}}</button><button type="button" class="btn-ghost text-xs" data-check-all="#notify-matrix" data-value="0">{{__ "Clear all"}}</button></div>{{end}}
            </div>
            <div class="overflow-x-auto" id="notify-matrix">
                <table class="table">
                    <thead class="bg-mist/60"><tr><th>{{__ "Module"}}</th><th>{{__ "Channel"}}</th>{{range .actions}}<th class="text-center">{{.}}</th>{{end}}</tr></thead>
                    <tbody>
                    {{range .rows}}
                        <tr class="{{if .First}}border-t-2 border-graphite-900/10{{end}}">
                            {{if .First}}<td rowspan="{{$.rowspan}}" class="align-top font-medium"><span class="flex items-center gap-2">{{icon .Icon "size-4 text-steel"}}{{.Name}}</span>{{if not .Enabled}}<span class="mt-1 block text-xs font-normal text-steel">{{__ "Coming soon"}}</span>{{end}}</td>{{end}}
                            <td class="whitespace-nowrap text-steel">{{.Channel}}</td>
                            {{range .Cells}}
                                <td class="text-center"><input type="checkbox" name="{{.Name}}" value="1" class="size-4 accent-signal-600" {{if .On}}checked{{end}} aria-label="{{.Aria}}"></td>
                            {{end}}
                        </tr>
                    {{end}}
                    </tbody>
                </table>
            </div>
        </section>

        <section class="panel overflow-hidden">
            <div class="panel-head"><h2 class="panel-title">{{__ "Security alerts"}}</h2></div>
            <div class="overflow-x-auto">
                <table class="table">
                    <thead class="bg-mist/60"><tr><th>{{__ "Event"}}</th>{{range .secChannels}}<th class="text-center">{{.}}</th>{{end}}</tr></thead>
                    <tbody>
                    {{range .security}}
                        <tr><td class="font-medium">{{.Label}}</td>
                            {{range .Cells}}<td class="text-center"><input type="checkbox" name="{{.Name}}" value="1" class="size-4 accent-signal-600" {{if .On}}checked{{end}} aria-label="{{.Aria}}"></td>{{end}}
                        </tr>
                    {{end}}
                    </tbody>
                </table>
            </div>
        </section>
    </fieldset>
    {{if $canEdit}}<div class="flex justify-end"><button class="btn-primary w-full sm:w-auto">{{__ "Save notification settings"}}</button></div>{{end}}
</form>
{{if $canEdit}}
<div class="mt-4 flex flex-wrap gap-2">
    <form method="POST" action="{{url "/settings/test-mail"}}">{{csrfField}}<button class="btn-secondary">{{icon "mail" "size-4"}} {{__ "Send me a test e-mail"}}</button></form>
    {{if ne .lark.mode "off"}}<form method="POST" action="{{url "/settings/test-lark"}}">{{csrfField}}<button class="btn-secondary">{{icon "chat" "size-4"}} {{__ "Send a test Lark message"}}</button></form>{{end}}
</div>
{{end}}
