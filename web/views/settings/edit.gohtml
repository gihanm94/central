{{- $canEdit := can "settings" "edit" -}}
{{- $brand := .brand -}}
{{template "settings/_tabs" .}}
<p class="mt-4 text-sm text-steel">{{__ "Your company name, logo, language and the picture people see when they sign in."}}</p>

<form method="POST" action="{{url "/settings"}}" enctype="multipart/form-data" class="mt-6 grid items-start gap-6 xl:grid-cols-5">
    {{csrfField}}
    <fieldset {{if not $canEdit}}disabled{{end}} class="panel xl:col-span-3">
        <div class="panel-head"><h2 class="panel-title">{{__ "Brand"}}</h2></div>
        <div class="space-y-5 p-5">
            <div><label for="company_name" class="label">{{__ "Company name"}}</label><input id="company_name" name="company_name" value="{{old "company_name" $brand.name}}" required class="input">{{fieldError "company_name"}}</div>
            <label class="flex items-start gap-3 text-sm"><input type="checkbox" name="access_requests" value="1" {{if .accessRequests}}checked{{end}} class="mt-0.5 size-4 accent-signal-600"><span><span class="font-medium">{{__ "Let people request an account on the sign-in page"}}</span><span class="block text-xs text-steel">{{__ "Requests wait in Members → Account requests until an administrator approves them."}}</span></span></label>
            <div><label for="login_banner" class="label">{{__ "Sign-in banner"}}</label><input id="login_banner" name="login_banner" value="{{old "login_banner" $brand.banner}}" maxlength="60" class="input"><p class="hint">{{__ "The name in the red band on the sign-in picture. Empty = the company name."}}</p></div>
            <div><label for="login_tagline" class="label">{{__ "Sign-in page message"}}</label><input id="login_tagline" name="login_tagline" value="{{old "login_tagline" $brand.tagline}}" maxlength="160" class="input"><p class="hint">{{__ "One short line shown under the company name."}}</p></div>
            <div><label for="support_email" class="label">{{__ "Support e-mail"}}</label><input id="support_email" name="support_email" type="email" value="{{old "support_email" $brand.support}}" placeholder="it-help@company.com" class="input"><p class="hint">{{__ "Shown on the sign-in page for people who need an account."}}</p>{{fieldError "support_email"}}</div>
            <div><label for="default_locale" class="label">{{__ "Default language"}}</label>{{select "default_locale" .locales (old "default_locale" .defaultLocale) (dict "id" "default_locale" "required" true)}}<p class="hint">{{__ "For the sign-in page and anyone who has not picked a language."}}</p></div>

            <div class="grid gap-5 sm:grid-cols-2">
                <div>
                    <span class="label">{{__ "Logo"}}</span>
                    <div class="flex h-24 items-center justify-center rounded-md bg-graphite-900 p-3">
                        <img id="logo-preview" src="{{$brand.logo}}" alt="" {{if not $brand.logo}}hidden{{end}} class="max-h-full max-w-full object-contain">
                        {{if not $brand.logo}}<span class="text-xs text-graphite-400">{{__ "No logo"}}</span>{{end}}
                    </div>
                    <input name="company_logo" type="file" accept="image/png,image/jpeg,image/webp" data-preview="#logo-preview" class="mt-2 w-full text-xs file:mr-2 file:rounded file:border-0 file:bg-graphite-900 file:px-2.5 file:py-1 file:text-white">
                    <p class="hint">{{__ "PNG or SVG with a transparent background suits the dark sidebar. Up to 2 MB."}}</p>
                    <label class="mt-2 flex items-center gap-2 text-sm"><input type="checkbox" name="auth_logo" value="1" {{if $brand.auth_logo}}checked{{end}} class="accent-signal-600"> {{__ "Show the logo on the sign-in page"}}</label>
                    {{if $brand.logo}}<label class="mt-1 flex items-center gap-2 text-xs text-steel"><input type="checkbox" name="remove_logo" value="1" class="accent-signal-600"> {{__ "Remove logo"}}</label>{{end}}
                </div>
                <div>
                    <span class="label">{{__ "Sign-in picture"}}</span>
                    <div class="relative h-24 overflow-hidden rounded-md bg-graphite-800">
                        <img id="login-preview" src="{{or $brand.login_image (asset "assets/auth-hero.webp")}}" alt="" class="size-full object-contain">
                        {{if not $brand.login_image}}<span class="absolute rounded px-1.5 text-[10px] text-graphite-300" style="bottom:.25rem; right:.375rem; background:rgba(0,0,0,.5)">{{__ "Built-in picture"}}</span>{{end}}
                    </div>
                    <input name="login_image" type="file" accept="image/jpeg,image/png,image/webp" data-preview="#login-preview" class="mt-2 w-full text-xs file:mr-2 file:rounded file:border-0 file:bg-graphite-900 file:px-2.5 file:py-1 file:text-white">
                    <p class="hint">{{__ "A wide photo of your site, plant or team, 1600 px or wider. Up to 5 MB."}}</p>
                    {{if $brand.login_image}}<label class="mt-1 flex items-center gap-2 text-xs text-steel"><input type="checkbox" name="remove_login_image" value="1" class="accent-signal-600"> {{__ "Use the built-in picture"}}</label>{{end}}
                </div>
            </div>
            {{fieldError "branding"}}
        </div>
        {{if $canEdit}}
            <div class="flex justify-end border-t border-graphite-900/8 px-5 py-3"><button class="btn-primary w-full sm:w-auto">{{__ "Save settings"}}</button></div>
        {{else}}
            <p class="border-t border-graphite-900/8 px-5 py-3 text-xs text-steel">{{__ "You can view these settings. Only administrators can change them."}}</p>
        {{end}}
    </fieldset>

    <div class="space-y-6 xl:col-span-2">
        <div>
            <p class="label">{{__ "Sign-in page preview"}}</p>
            <div class="grid aspect-[16/10] grid-cols-[1.15fr_0.85fr] overflow-hidden rounded-lg bg-graphite-950 ring-1 ring-graphite-900/10">
                <div class="relative overflow-hidden bg-graphite-800">
                    <img src="{{or $brand.login_image (asset "assets/auth-hero.webp")}}" alt="" class="absolute inset-0 size-full object-contain p-3">
                    <div class="absolute inset-0 bg-gradient-to-t from-graphite-950 to-transparent"></div>
                    <div class="absolute bottom-[22%] left-0 right-[8%] bg-signal-600 py-2 pl-4" style="clip-path: polygon(0 0,100% 0,94% 100%,0 100%)"><p class="truncate font-display text-lg font-bold text-white">{{$brand.banner}}</p></div>
                </div>
                <div class="flex flex-col justify-center gap-2 p-4"><div class="h-2.5 w-1/2 rounded bg-white/80"></div><div class="mt-2 h-5 rounded bg-graphite-800"></div><div class="h-5 rounded bg-graphite-800"></div><div class="mt-1 h-5 rounded bg-signal-600"></div></div>
            </div>
            <p class="mt-2 text-xs text-steel">{{__ "Save to see changes in the preview."}}</p>
        </div>

        <section class="panel">
            <div class="panel-head"><h2 class="panel-title">{{__ "E-mail delivery"}}</h2></div>
            <div class="space-y-1 p-5 text-sm">
                <p>{{__ "Driver"}}: <strong>{{.mail.driver}}</strong>{{if eq .mail.driver "smtp"}} via {{.mail.host}}:{{.mail.port}}{{end}}</p>
                <p class="text-steel">{{if eq .mail.driver "log"}}{{__ "E-mails are saved as files in storage/mail instead of being sent. Switch to SMTP in config/config.json when ready."}}{{else}}{{__ "Sent from :address." "address" .mail.from}}{{end}}</p>
            </div>
        </section>
    </div>
</form>
{{if $canEdit}}
<form method="POST" action="{{url "/settings/test-mail"}}" class="mt-4 xl:ml-[60%] xl:pl-6">
    {{csrfField}}<button class="btn-secondary">{{icon "mail" "size-4"}} {{__ "Send me a test e-mail"}}</button>
</form>
{{end}}
