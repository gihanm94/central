{{- /* .t .db .dbName .rowsAbout .columns .roles .users .open .label .placeholder .syncs */ -}}
<div class="mx-auto max-w-4xl">
<a href="{{url "/sheets/tables" "db" .db}}" class="text-sm text-steel hover:text-graphite-900">← {{__ "Tables & access"}} · {{.dbName}}</a>
<h1 class="page-title mt-1">{{.title}} <span class="font-mono text-base font-normal text-steel">{{.db}}.{{.t.table_name}}</span></h1>
<p class="mt-1 text-sm text-steel">{{__ "About :n rows." "n" .rowsAbout}} {{__ "People given this table get every row of it in their Google Sheet, whatever they may see on screen."}}</p>

<form method="POST" action="{{url "/sheets/tables/save"}}" class="mt-4 grid gap-4">{{csrfField}}
    <input type="hidden" name="db" value="{{.db}}"><input type="hidden" name="table" value="{{.t.table_name}}">
    <section class="panel">
        <div class="grid gap-4 p-5 sm:grid-cols-2">
            <label class="flex items-center gap-3 text-sm font-medium sm:col-span-2"><input type="checkbox" name="enabled" value="1" class="size-5 accent-signal-600" {{if .open}}checked{{end}}> {{__ "Open this table for Google Sheets"}}</label>
            <div class="sm:col-span-2"><label class="label" for="f-label">{{__ "Name people see"}}</label><input id="f-label" name="label" value="{{.label}}" class="input" placeholder="{{.placeholder}}"></div>
        </div>
    </section>

    <div class="grid gap-4 md:grid-cols-2">
        <section class="panel">
            <div class="panel-head"><h2 class="panel-title">{{__ "Roles that may sync it"}}</h2></div>
            <div class="grid gap-1.5 p-5 text-sm">
                {{range .roles}}
                    <label class="flex items-center gap-2"><input type="checkbox" name="roles[]" value="{{.ID}}" class="size-4 accent-signal-600" {{if .Checked}}checked{{end}}> {{.Name}}</label>
                {{end}}
                <p class="mt-2 text-xs text-steel">{{__ "Administrators can always sync open tables."}}</p>
            </div>
        </section>
        <section class="panel">
            <div class="panel-head"><h2 class="panel-title">{{__ "…and these people"}}</h2><span class="text-xs text-steel" data-count></span></div>
            <div class="p-3"><input type="search" class="input" placeholder="{{__ "Filter people…"}}" oninput="var q=this.value.toLowerCase();this.parentNode.nextElementSibling.querySelectorAll('label').forEach(function(l){l.hidden=q&&l.textContent.toLowerCase().indexOf(q)<0})"></div>
            <div class="grid max-h-72 gap-1.5 overflow-y-auto px-5 pb-4 text-sm">
                {{range .users}}
                    <label class="flex items-center gap-2"><input type="checkbox" name="users[]" value="{{.ID}}" class="size-4 accent-signal-600" {{if .Checked}}checked{{end}}>
                        <span class="min-w-0 truncate">{{.Name}} <span class="text-xs text-steel">{{.Sub}}</span></span></label>
                {{end}}
            </div>
        </section>
    </div>

    <section class="panel">
        <div class="panel-head"><h2 class="panel-title">{{__ "Columns sent"}}</h2><span class="text-xs text-steel">{{__ "Untick to keep a column out of Google Sheets"}}</span></div>
        <div class="grid gap-1.5 p-5 text-sm sm:grid-cols-2 lg:grid-cols-3">
            {{range .columns}}
                <label class="flex items-center gap-2 {{if .Secret}}text-graphite-400{{end}}" {{if .Secret}}title="{{__ "Never sent: looks like a password, token or key"}}"{{end}}>
                    <input type="checkbox" name="columns[]" value="{{.Name}}" class="size-4 accent-signal-600" {{if .Secret}}disabled{{else if .Shown}}checked{{end}}>
                    <span class="font-mono text-xs">{{.Name}}</span> <span class="text-xs text-steel">{{.Type}}</span>{{if .Secret}}{{icon "lock" "size-3.5"}}{{end}}</label>
            {{end}}
        </div><div class="px-5 pb-3">{{fieldError "columns"}}</div>
    </section>

    {{if .syncs}}
    <section class="panel">
        <div class="panel-head"><h2 class="panel-title">{{__ "Current syncs of this table"}}</h2><span class="text-xs text-steel">{{len .syncs}}</span></div>
        <ul class="divide-y divide-graphite-900/6 text-sm">{{range .syncs}}
            <li class="px-5 py-2"><span class="font-medium">{{.name}}</span> → {{or .spreadsheet_name "?"}} / {{.sheet_tab}}{{if not (bool .active)}} <span class="text-xs text-steel">({{__ "paused"}})</span>{{end}}</li>
        {{end}}</ul>
    </section>
    {{end}}

    <div class="flex justify-end gap-2"><a href="{{url "/sheets/tables" "db" .db}}" class="btn-ghost">{{__ "Cancel"}}</a><button class="btn-primary">{{__ "Save"}}</button></div>
</form>
</div>
