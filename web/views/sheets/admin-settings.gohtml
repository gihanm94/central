{{- /* .office .days .maxRows .configured .redirect */ -}}
<div class="min-w-0"><h1 class="page-title">{{__ "Google Sheets settings"}}</h1></div>
<div class="mt-4 grid gap-4 lg:grid-cols-3">
    <form method="POST" action="{{url "/sheets/settings"}}" class="panel lg:col-span-2">{{csrfField}}
        <div class="panel-head"><h2 class="panel-title">{{__ "Office hours (no syncing)"}}</h2></div>
        <div class="grid gap-4 p-5 sm:grid-cols-2">
            <div><label class="label" for="f-s">{{__ "From"}}</label><input id="f-s" type="time" name="office_start" value="{{old "office_start" .office.Start}}" class="input">{{fieldError "office_start"}}</div>
            <div><label class="label" for="f-e">{{__ "Until"}}</label><input id="f-e" type="time" name="office_end" value="{{old "office_end" .office.End}}" class="input">{{fieldError "office_end"}}</div>
            <div class="sm:col-span-2"><span class="label">{{__ "On"}}</span>
                <div class="flex flex-wrap gap-1.5">{{range .days}}
                    <label class="flex items-center gap-1.5 rounded-md border border-graphite-900/10 px-2.5 py-1 text-sm has-[:checked]:border-signal-600 has-[:checked]:bg-signal-50"><input type="checkbox" name="office_days[]" value="{{.N}}" class="size-4 accent-signal-600" {{if .Checked}}checked{{end}}> {{.Label}}</label>
                {{end}}</div></div>
            <div><label class="label" for="f-max">{{__ "Most rows per sync"}}</label><input id="f-max" type="number" name="max_rows" min="100" max="1000000" value="{{old "max_rows" .maxRows}}" class="input">{{fieldError "max_rows"}}
                <p class="mt-1 text-xs text-steel">{{__ "A Google spreadsheet holds at most 10 million cells."}}</p></div>
        </div>
        <div class="flex justify-end border-t border-graphite-900/8 bg-mist/50 px-5 py-3"><button class="btn-primary">{{__ "Save"}}</button></div>
    </form>
    <section class="panel">
        <div class="panel-head"><h2 class="panel-title">{{__ "Set up Google"}}</h2><span class="badge {{if .configured}}bg-emerald-50 text-emerald-800{{else}}bg-amber-50 text-amber-800{{end}}">{{if .configured}}{{__ "Ready"}}{{else}}{{__ "Not set up"}}{{end}}</span></div>
        <ol class="list-decimal space-y-2 px-8 py-4 text-sm text-steel">
            <li>{{__ "Uses the same OAuth client as Administration → Connectors, with the same redirect URI:"}} <code class="break-all text-xs">{{.redirect}}</code></li>
            <li>{{__ "In Google Cloud Console enable the Google Sheets API and the Google Drive API."}}</li>
            <li>{{__ "On the consent screen add the scopes spreadsheets and drive.metadata.readonly."}}</li>
            <li>{{__ "Run bin/sheets-sync.php from cron every 5 minutes, so evening and night syncs run when nobody is signed in."}}</li>
        </ol>
    </section>
</div>
