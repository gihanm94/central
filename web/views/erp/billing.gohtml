{{- /* .f .result (nil = unavailable) .rows .depNames .myDept .isAdmin .allDepartments .page .pages .prev .next .depSelect */ -}}
<div class="flex flex-wrap items-end justify-between gap-4">
    <div class="min-w-0"><h1 class="page-title">{{__ "Billing notes"}}</h1>
        <p class="mt-1 text-sm text-steel">{{if .isAdmin}}{{__ "Billing notes sent to customers, for every department."}}{{else}}{{__ "Billing notes sent to customers for your department: :d." "d" (or .myDept (__ "none"))}}{{end}}</p></div>
</div>

{{if not .result}}
    <section class="panel mt-4 px-5 py-10 text-center text-sm text-steel">{{__ "Billing notes are temporarily unavailable. Everything else keeps working."}}</section>
{{else if and (not .isAdmin) (not .myDept)}}
    <section class="panel mt-4 px-5 py-10 text-center text-sm text-steel">{{__ "Your account has no department yet, so there are no billing notes to show. Ask an administrator."}}</section>
{{else}}
<section class="panel mt-4 overflow-hidden">
    <form method="GET" action="{{url "/erp/billing"}}" class="flex flex-wrap items-end gap-2 border-b border-graphite-900/8 p-3">
        <div class="min-w-[14rem] flex-1"><label class="label" for="f-q">{{__ "Search"}}</label><input id="f-q" name="q" value="{{.f.q}}" class="input" placeholder="{{__ "Billing no., customer, invoice no."}}"></div>
        <div><label class="label" for="f-from">{{__ "From"}}</label><input id="f-from" type="date" name="from" value="{{.f.from}}" class="input"></div>
        <div><label class="label" for="f-to">{{__ "To"}}</label><input id="f-to" type="date" name="to" value="{{.f.to}}" class="input"></div>
        {{if .isAdmin}}
            <div><label class="label" for="f-dep">{{__ "Department"}}</label>
                <div class="min-w-[12rem]">{{.depSelect}}</div></div>
        {{end}}
        <button class="btn-secondary">{{__ "Show"}}</button>
        <span class="ml-auto self-center text-sm text-steel">{{int .result.total}} {{__ "billing notes"}}</span>
    </form>
    <div class="overflow-x-auto"><table class="w-full text-sm">
        <thead class="bg-mist/60 text-left text-xs text-steel"><tr>
            <th class="px-4 py-2 font-medium">{{__ "Billing note"}}</th><th class="px-3 py-2 font-medium">{{__ "Date"}}</th>
            <th class="px-3 py-2 font-medium">{{__ "Customer"}}</th><th class="px-3 py-2 font-medium">{{__ "Invoices"}}</th>
            {{if .allDepartments}}<th class="px-3 py-2 font-medium">{{__ "Department"}}</th>{{end}}
            <th class="px-3 py-2 text-right font-medium">{{__ "Total"}}</th><th class="px-3 py-2 font-medium">{{__ "Status"}}</th>
            <th class="px-3 py-2 font-medium">PDF</th></tr></thead>
        <tbody class="divide-y divide-graphite-900/6">
        {{range $r := .rows}}{{$u := url (printf "/erp/billing/%v/pdf" (int $r.id))}}
            <tr>
                <td class="px-4 py-2.5"><span class="font-medium tabular-nums">{{$r.billing_number}}</span>
                    {{if $r.remind_date}}<span class="block text-xs text-steel">{{__ "Due :d" "d" (formatDate $r.remind_date)}}</span>{{end}}</td>
                <td class="whitespace-nowrap px-3 py-2.5 text-steel">{{formatDate $r.billing_at}}</td>
                <td class="px-3 py-2.5">{{or $r.customer_name "—"}}<span class="block text-xs text-steel">{{or $r.customer_code ""}}</span></td>
                <td class="max-w-[16rem] px-3 py-2.5"><span class="tabular-nums">{{int $r.invoice_count}}</span>
                    <span class="block truncate text-xs text-steel" title="{{str $r.invoice_numbers}}">{{str $r.invoice_numbers}}</span></td>
                {{if $.allDepartments}}<td class="px-3 py-2.5 text-steel">{{or (get $.depNames (int $r.app_department_id)) "—"}}</td>{{end}}
                <td class="whitespace-nowrap px-3 py-2.5 text-right tabular-nums">{{nf $r.total_amount 2}} {{or $r.currency_code ""}}</td>
                <td class="whitespace-nowrap px-3 py-2.5">
                    {{if bool $r.is_paid}}<span class="badge bg-emerald-50 text-emerald-800">{{__ "Paid"}}</span>
                    {{else if bool $r.is_complete}}<span class="badge bg-sky-50 text-sky-800">{{__ "Complete"}}</span>
                    {{else}}<span class="badge bg-amber-50 text-amber-800">{{__ "Open"}}</span>{{end}}</td>
                <td class="px-3 py-2.5"><span class="inline-flex overflow-hidden rounded-md ring-1 ring-graphite-900/10">
                    <a href="{{$u}}" target="_blank" rel="noopener" class="px-2 py-1 text-xs font-medium hover:bg-mist">{{__ "View"}}</a>
                    <a href="{{$u}}?download=1" class="border-l border-graphite-900/10 px-1.5 py-1 hover:bg-mist" title="{{__ "Download"}}" aria-label="{{__ "Download :d" "d" $r.billing_number}}">{{icon "download" "size-3.5"}}</a>
                </span></td>
            </tr>
        {{end}}
        {{if not .rows}}<tr><td colspan="8" class="px-4 py-10 text-center text-steel">{{__ "No billing notes found."}}</td></tr>{{end}}
        </tbody>
    </table></div>
    {{if gt .pages 1}}
        <div class="flex items-center justify-end gap-2 border-t border-graphite-900/8 px-4 py-2 text-sm">
            <a class="btn-secondary !h-8 !px-3 {{if le .page 1}}pointer-events-none opacity-40{{end}}" href="{{.prev}}">‹</a>
            <span>{{.page}} / {{.pages}}</span>
            <a class="btn-secondary !h-8 !px-3 {{if ge .page .pages}}pointer-events-none opacity-40{{end}}" href="{{.next}}">›</a>
        </div>
    {{end}}
</section>
{{end}}
