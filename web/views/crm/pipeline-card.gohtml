{{- /* One card of the board. .o (opportunity row) .mine .movable .late .creator .ownerName .lead .stages (Code Color Label) .prob .probText .money .closeShort */ -}}
{{- $o := .o -}}
<article class="kb-card group relative rounded-lg bg-white p-3 text-sm shadow-sm {{if .mine}}ring-2 ring-signal-600{{else}}ring-1 ring-graphite-900/10{{end}} {{if .movable}}cursor-grab active:cursor-grabbing{{end}}"
         data-id="{{$o.id}}" data-stage="{{$o.opportunity_stage}}" data-mine="{{if .mine}}1{{else}}0{{end}}" {{if .movable}}draggable="true"{{end}}
         {{if not .movable}}title="{{__ "Only :name, who created this, can move it." "name" .creator}}"{{end}}>
    <div class="flex items-start justify-between gap-2">
        <a href="{{url (printf "/crm/opportunities/%v" $o.id)}}" class="min-w-0 font-medium leading-snug hover:text-signal-700" draggable="false">{{$o.name}}</a>
        <span class="flex shrink-0 items-center gap-1">
            {{if .mine}}<span class="sr-only">{{__ "Mine"}}</span>{{end}}
            {{if .movable}}
            <span class="relative">
                <button type="button" class="btn-ghost size-6 px-0" data-menu="#cm-{{$o.id}}" data-placement="bottom-end" aria-haspopup="menu" aria-expanded="false" aria-label="{{__ "Move :name to…" "name" $o.name}}">{{icon "dots" "size-4"}}</button>
                <span id="cm-{{$o.id}}" data-menu-panel hidden role="menu" class="fixed z-[70] w-52 rounded-lg bg-white p-1.5 text-sm font-normal shadow-xl ring-1 ring-graphite-900/10">
                    <span class="block px-2 pb-1 pt-0.5 text-xs text-steel">{{__ "Move to"}}</span>
                    {{range .stages}}<button type="button" role="menuitem" data-move-to="{{.Code}}" class="flex w-full items-center gap-2 rounded-md px-2 py-1.5 text-left hover:bg-mist"><span class="size-2.5 rounded-full" style="{{css (printf "background:%s" .Color)}}"></span>{{.Label}}</button>{{end}}
                </span>
            </span>
            {{else}}<span class="text-graphite-400" aria-hidden="true">{{icon "lock" "size-3.5"}}</span>{{end}}
        </span>
    </div>
    {{if $o.lead_name}}
    <div class="mt-2">{{.lead}}</div>
    {{end}}
    <div class="mt-2.5 flex items-center justify-between gap-2">
        <span class="font-semibold tabular-nums">{{.money}}</span>
        {{if .prob}}<span class="text-xs tabular-nums text-steel">{{.probText}}%</span>{{end}}
    </div>
    <div class="mt-1.5 flex items-center justify-between gap-2 text-xs text-steel">
        <span class="flex min-w-0 items-center gap-1.5">{{template "partials/avatar" (dict "name" .ownerAvatar "size" "size-5" "extra" "text-[9px]")}}<span class="truncate">{{.ownerName}}</span></span>
        {{if $o.close_at}}<span class="shrink-0 tabular-nums {{if .late}}font-medium text-signal-700{{end}}">{{.closeShort}}</span>{{end}}
    </div>
</article>
