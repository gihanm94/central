{{- /* "Share with" step of a new record. .f.Extra: targets []Opt, levels []Opt, dept (the creator's department), rows (old input) */ -}}
{{- $x := .f.Extra -}}
<div class="rounded-lg bg-mist/60 p-4 text-sm">
    <p class="flex items-start gap-2.5">{{icon "building" "mt-0.5 size-4 shrink-0 text-steel"}}
        <span>{{if $x.dept}}<span class="font-medium">{{__ "Everyone in :dept can already see this record." "dept" $x.dept}}</span>{{else}}<span class="font-medium">{{__ "Only you can see this record until you share it."}}</span>{{end}}
        <span class="block text-xs text-steel">{{__ "It belongs to you and your department automatically. Admin and management roles see everything. Add anyone else who should have access:"}}</span></span></p>
</div>
<div data-repeat data-min="0" class="mt-3 space-y-2">
    <div data-repeat-rows class="space-y-2">{{range $x.rows}}{{template "crm/fields/access-row" (dict "i" .I "target" .Target "level" .Level "x" $x)}}{{end}}</div>
    <template data-repeat-template>{{template "crm/fields/access-row" (dict "i" "__i__" "target" "" "level" "view" "x" $x)}}</template>
    <input type="hidden" data-repeat-next value="{{len $x.rows}}">
    <button type="button" data-repeat-add class="btn-secondary">{{icon "plus" "size-4"}} {{__ "Add a person or department"}}</button>
</div>
{{if .err}}<p class="error">{{.err}}</p>{{end}}
{{- define "crm/fields/access-row"}}
    <div data-repeat-row class="grid grid-cols-12 items-start gap-2 rounded-md bg-mist/50 p-3">
        <div class="col-span-12 sm:col-span-7">{{select (printf "access[%s][target]" .i) .x.targets .target (dict "placeholder" (__ "Choose a person or department…") "id" (printf "acc-t-%s" .i) "aria" (__ "Person or department"))}}</div>
        <div class="col-span-9 sm:col-span-3">{{select (printf "access[%s][level]" .i) .x.levels (or .level "view") (dict "id" (printf "acc-l-%s" .i) "search" false "required" true "aria" (__ "Access level"))}}</div>
        <div class="col-span-3 flex justify-end sm:col-span-2"><button type="button" data-repeat-remove class="btn-ghost px-2 hover:text-signal-700" aria-label="{{__ "Remove"}}">{{icon "trash" "size-4"}}</button></div>
    </div>
{{end -}}
