{{- /* Opportunity stage tracker. .row .nodes (Key Label State Style) .banner .bannerText .bannerStyle .inStage .showExpected .canEdit .final .options */ -}}
{{- $row := .row -}}
<section id="stage" class="panel mt-6 p-5">
    <ol class="grid grid-cols-5 gap-1.5 sm:gap-2" aria-label="{{__ "Opportunity stages"}}">
        {{range .nodes}}
            <li {{if eq .State "current"}}aria-current="step"{{end}}>
                <span class="block h-2 rounded-full {{if eq .State "todo"}}bg-graphite-900/10{{end}}" style="{{css .Style}}"></span>
                <span class="mt-2 flex items-start gap-1 text-[11px] leading-tight sm:text-xs {{if eq .State "current"}}font-semibold text-graphite-900{{else if eq .State "todo"}}text-graphite-400{{else}}text-steel{{end}}">
                    {{if eq .State "done"}}{{icon "tick" "mt-px size-3.5 shrink-0"}}{{end}}
                    <span class="min-w-0 break-words">{{.Label}}</span>
                </span>
            </li>
        {{end}}
    </ol>

    {{if .banner}}
    <div class="mt-4 flex items-start gap-3 rounded-md px-4 py-3 text-sm text-graphite-900" style="{{.bannerStyle}}">
        {{icon .banner "mt-0.5 size-4 shrink-0"}}
        <div class="min-w-0"><p class="font-medium">{{.bannerText}}</p>
            {{if $row.cancel_reason}}<p class="mt-0.5 whitespace-pre-line break-words">{{$row.cancel_reason}}</p>{{end}}</div>
    </div>
    {{end}}

    <div class="mt-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 text-sm text-steel">
        <p>{{.inStage}}
            {{if $row.follow_at}} · {{__ "Follow-up :date" "date" (formatDate $row.follow_at "d M Y")}}{{end}}
            {{if .showExpected}} · {{__ "Expected close :date" "date" (formatDate $row.close_at "d M Y")}}{{end}}</p>
        {{if .canEdit}}<button type="button" class="btn-secondary py-1.5" data-toggle="#move-stage" aria-expanded="false">{{icon "right" "size-4"}} {{__ "Move to another stage"}}</button>
        {{else if .final}}<span class="inline-flex items-center gap-1.5 text-xs">{{icon "lock" "size-4"}} {{__ "Closed: the stage can no longer be changed. Duplicate it to start a new one."}}</span>{{end}}
    </div>

    {{if .canEdit}}
    <form id="move-stage" hidden method="POST" action="{{url (printf "/crm/opportunities/%v/stage" $row.id)}}" class="mt-4 grid gap-3 border-t border-graphite-900/8 pt-4 sm:grid-cols-3">
        {{csrfField}}
        <div><label for="move-stage-pick" class="label">{{__ "New stage"}}</label>
            {{select "stage" .options "" (dict "placeholder" (__ "Choose a stage…") "id" "move-stage-pick" "required" true)}}{{fieldError "stage"}}</div>
        <div class="sm:col-span-2"><label for="move-note" class="label">{{__ "Note"}} <span class="font-normal text-steel">({{__ "required for lost, cancelled and on hold"}})</span></label>
            <textarea id="move-note" name="note" rows="2" maxlength="2000" class="input {{if errorFor "note"}}input-error{{end}}" placeholder="{{__ "What happened? This goes into the history."}}"></textarea>{{fieldError "note"}}</div>
        <div class="flex justify-end gap-2 sm:col-span-3"><button type="button" class="btn-ghost" data-toggle="#move-stage">{{__ "Cancel"}}</button><button class="btn-primary">{{__ "Move stage"}}</button></div>
    </form>
    {{end}}
</section>
