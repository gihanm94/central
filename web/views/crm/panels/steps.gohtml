{{- /* Next steps + history of an opportunity. .row .open (sorted by due date) .past (newest first) .canEdit */ -}}
{{- $base := url (printf "/crm/opportunities/%v" .row.id) -}}{{- $canEdit := .canEdit -}}{{- $np := len .past -}}
<section id="progress" class="panel">
    <div class="panel-head"><h2 class="panel-title">{{__ "Progress and next steps"}}</h2></div>

    <div class="border-b border-graphite-900/8 p-5">
        <h3 class="text-xs font-semibold text-steel">{{__ "Next steps"}}</h3>
        {{if not .open}}<p class="mt-2 text-sm text-steel">{{__ "Nothing planned. Add the next step so the team knows what comes next."}}</p>
        {{else}}
        <ul class="mt-2 space-y-2">
            {{range $i, $s := .open}}
            <li class="rounded-md ring-1 {{if eq $i 0}}bg-signal-50/40 ring-signal-600/25{{else}}ring-graphite-900/10{{end}}">
                <div class="flex flex-wrap items-start justify-between gap-3 px-4 py-3">
                    <div class="min-w-0">
                        <p class="text-sm font-medium break-words">{{$s.title}}{{if eq $i 0}} <span class="badge ml-1 bg-signal-600 text-white">{{__ "Next"}}</span>{{end}}</p>
                        <p class="mt-0.5 text-xs text-steel">{{$s._stage}} · {{$s.creator}}
                            {{if $s.due_at}} · <span class="{{if $s._late}}font-medium text-signal-700{{end}}">{{__ "Due :date" "date" (formatDate $s.due_at "d M Y")}}{{if $s._late}} · {{__ "Overdue"}}{{end}}</span>{{end}}</p>
                        {{if $s.note}}<p class="mt-1 whitespace-pre-line break-words text-sm text-graphite-800">{{$s.note}}</p>{{end}}
                    </div>
                    {{if $canEdit}}
                    <div class="flex shrink-0 items-center gap-1">
                        <details class="relative">
                            <summary class="btn-secondary cursor-pointer list-none py-1">{{icon "tick" "size-4"}} {{__ "Done"}}</summary>
                            <form method="POST" action="{{$base}}/steps/{{$s.id}}/done" class="absolute right-0 z-10 mt-1 w-72 max-w-[80vw] space-y-2 rounded-lg bg-white p-3 shadow-xl ring-1 ring-graphite-900/10">{{csrfField}}
                                <label class="text-xs font-medium" for="done-note-{{$s.id}}">{{__ "What was the result?"}} <span class="font-normal text-steel">({{__ "optional"}})</span></label>
                                <textarea id="done-note-{{$s.id}}" name="note" rows="2" class="input"></textarea>
                                <div class="flex justify-end"><button class="btn-dark py-1">{{__ "Mark as done"}}</button></div>
                            </form>
                        </details>
                        <form method="POST" action="{{$base}}/steps/{{$s.id}}/delete" data-confirm="{{__ "Remove this step?"}}">{{csrfField}}
                            <button class="btn-ghost px-1.5 py-1 hover:text-signal-700" title="{{__ "Remove step"}}" aria-label="{{__ "Remove step :title" "title" $s.title}}">{{icon "trash" "size-4"}}</button></form>
                    </div>
                    {{end}}
                </div>
            </li>
            {{end}}
        </ul>
        {{end}}

        {{if $canEdit}}
        <form method="POST" action="{{$base}}/steps" class="mt-4 grid gap-3 sm:grid-cols-6">
            {{csrfField}}
            <div class="sm:col-span-3"><label for="step-title" class="label">{{__ "Add a next step"}}</label>
                <input id="step-title" name="title" required maxlength="200" class="input {{if errorFor "title"}}input-error{{end}}" placeholder="{{__ "e.g. Send revised quotation"}}">{{fieldError "title"}}</div>
            <div class="sm:col-span-2"><label for="step-due" class="label">{{__ "Due date"}} <span class="font-normal text-steel">({{__ "optional"}})</span></label>
                <input id="step-due" name="due_at" type="date" class="input">{{fieldError "due_at"}}</div>
            <div class="flex items-end sm:col-span-1"><button class="btn-dark w-full">{{icon "plus" "size-4"}} {{__ "Add"}}</button></div>
        </form>
        {{end}}
    </div>

    <div class="p-5">
        <h3 class="text-xs font-semibold text-steel">{{__ "History"}}</h3>
        {{if not .past}}<p class="mt-2 text-sm text-steel">{{__ "No history yet."}}</p>
        {{else}}
        <ol class="mt-3 space-y-0">
            {{range $i, $s := .past}}
            <li class="relative flex gap-3 pb-5 last:pb-0">
                {{if lt $i (sub $np 1)}}<span class="absolute left-[13px] top-7 h-[calc(100%-1.75rem)] w-px bg-graphite-900/12" aria-hidden="true"></span>{{end}}
                <span class="relative z-[1] flex size-7 shrink-0 items-center justify-center rounded-full ring-4 ring-white {{if $s._stagekind}}bg-graphite-800 text-white{{else}}bg-emerald-600 text-white{{end}}">{{if $s._stagekind}}{{icon "right" "size-3.5"}}{{else}}{{icon "tick" "size-3.5"}}{{end}}</span>
                <div class="min-w-0 flex-1 pt-0.5">
                    <p class="text-sm break-words">
                        {{if $s._stagekind}}{{$s._text}}
                        {{else}}<span class="font-medium">{{$s.title}}</span> <span class="text-steel">— {{__ "done"}}</span>{{end}}
                    </p>
                    {{if $s.note}}<p class="mt-0.5 whitespace-pre-line break-words text-sm text-graphite-800">{{$s.note}}</p>{{end}}
                    <p class="mt-0.5 text-xs text-steel">{{$s._who}} · <time datetime="{{$s._iso}}" title="{{formatDate $s._at "d M Y H:i"}}">{{timeAgo $s._at}}</time>{{if not $s._stagekind}} · {{$s._stage}}{{end}}</p>
                </div>
            </li>
            {{end}}
        </ol>
        {{end}}
    </div>
</section>
