{{- /* .title .people [[name department]] .history .dlg .historyHTML (dialog) */ -}}
<section class="panel">
    <div class="panel-head"><h2 class="panel-title">{{.title}} <span class="ml-1 text-sm font-normal text-steel">{{len .people}}</span></h2></div>
    {{if not .people}}
        <p class="px-5 py-5 text-center text-sm text-steel">{{__ "Nobody yet."}}</p>
    {{else}}
    <ul class="divide-y divide-graphite-900/6">
        {{range .people}}
        <li class="flex items-center gap-3 px-5 py-2.5"><span class="inline-flex size-8 shrink-0 items-center justify-center rounded-full bg-graphite-900/6 text-xs font-semibold text-graphite-700">{{initials .name}}</span>
            <span class="min-w-0"><span class="block truncate text-sm font-medium">{{.name}}</span>{{if .department}}<span class="block truncate text-xs text-steel">{{.department}}</span>{{end}}</span></li>
        {{end}}
    </ul>
    {{end}}
    {{if .history}}
    <div class="flex items-center justify-between gap-3 border-t border-graphite-900/8 bg-mist/50 px-5 py-3">
        <div class="min-w-0 text-xs text-steel">
            <p class="font-semibold uppercase tracking-wide">{{__ "History"}} <span class="font-normal normal-case">({{len .history}})</span></p>
            <p class="mt-0.5 truncate">{{__ "Last change :date" "date" (formatDate (index .history 0).created_at "d M Y")}}</p>
        </div>
        <button type="button" class="btn-secondary h-8 shrink-0 px-3 text-xs" data-open-dialog="{{.dlg}}">{{icon "clock" "size-4"}} {{__ "View history"}}</button>
    </div>
    {{.historyHTML}}
    {{end}}
</section>
