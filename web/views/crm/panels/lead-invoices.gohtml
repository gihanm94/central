{{- /* Lead → Invoices tab: ERP invoices with the lead's tax ID. .row (lead), .data {rows total sum more} from Accounting (nil = unavailable) */ -}}
<section class="panel overflow-hidden">
    <div class="panel-head">
        <h2 class="panel-title">{{__ "Invoices"}} <span class="ml-1 text-sm font-normal text-steel">{{__ "tax ID :tax" "tax" .row.tax_id}}</span></h2>
        {{if .data}}{{if .data.total}}<span class="text-sm tabular-nums">{{__ ":n invoices · :v" "n" .data.total "v" .data.sum}}</span>{{end}}{{end}}
    </div>
    {{if not .data}}
        <p class="px-5 py-8 text-center text-sm text-steel">{{__ "The ERP data is not available right now (the Accounting module is off or unavailable)."}}</p>
    {{else if not .data.rows}}
        <p class="px-5 py-8 text-center text-sm text-steel">{{__ "No ERP invoices with this tax ID."}}</p>
    {{else}}
    <div class="overflow-x-auto"><table class="w-full text-sm">
        <thead class="bg-mist/60 text-left text-xs text-steel"><tr>
            <th class="px-5 py-2 font-medium">{{__ "Invoice no."}}</th><th class="px-3 py-2 font-medium">{{__ "Seller"}}</th>
            <th class="px-3 py-2 font-medium">{{__ "Date"}}</th><th class="px-5 py-2 text-right font-medium">{{__ "Amount"}}</th></tr></thead>
        <tbody class="divide-y divide-graphite-900/6">
        {{range .data.rows}}
            <tr>
                <td class="px-5 py-2.5"><span class="font-medium tabular-nums">{{.invoice_number}}</span>{{if ._credit}} <span class="badge bg-amber-50 text-amber-800">CN</span>{{end}}
                    <span class="block text-xs text-steel">{{._ref}}</span></td>
                <td class="px-3 py-2.5">{{or .seller "—"}}</td>
                <td class="whitespace-nowrap px-3 py-2.5 text-steel">{{if .invoice_date}}{{formatDate .invoice_date}}{{else}}—{{end}}</td>
                <td class="whitespace-nowrap px-5 py-2.5 text-right tabular-nums {{if ._credit}}text-signal-700{{end}}">{{._amount}}</td>
            </tr>
        {{end}}
        </tbody>
    </table></div>
    {{if .data.more}}<p class="border-t border-graphite-900/8 px-5 py-2 text-xs text-steel">{{__ "Showing the newest :n of :t." "n" (len .data.rows) "t" .data.total}}</p>{{end}}
    <p class="border-t border-graphite-900/8 px-5 py-2 text-xs text-steel">{{__ "Amounts before VAT, from the ERP. Credit notes are shown as minus."}}</p>
    {{end}}
</section>
