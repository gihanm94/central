{{- /* Owner, department and history of a record. .row .type .canHand .before .dlg .history (dialog html) .targets .path .all */ -}}
{{- $row := .row -}}
<section class="panel">
    <div class="panel-head"><h2 class="panel-title">{{__ "Record"}}</h2></div>
    <dl class="divide-y divide-graphite-900/6 text-sm">
        <div class="flex items-center justify-between gap-3 px-5 py-3">
            <dt class="text-steel">{{__ "Owner"}}</dt>
            <dd class="flex min-w-0 items-center gap-2 font-medium">{{if $row.owner_name}}{{template "partials/avatar" (dict "name" $row.owner_name "size" "size-6" "extra" "text-[10px]")}}<span class="truncate">{{$row.owner_name}}</span>{{else}}—{{end}}</dd>
        </div>
        <div class="flex items-center justify-between gap-3 px-5 py-3"><dt class="text-steel">{{__ "Department"}}</dt><dd class="truncate font-medium">{{coalesce $row.department_name "—"}}</dd></div>
        <div class="flex items-center justify-between gap-3 px-5 py-3"><dt class="text-steel">{{__ "Created"}}</dt><dd class="truncate text-right">{{formatDate $row.created_at "d M Y"}}{{if $row.creator_name}}<span class="block text-xs text-steel">{{$row.creator_name}}</span>{{end}}</dd></div>
        <div class="flex items-center justify-between gap-3 px-5 py-3"><dt class="text-steel">{{__ "Updated"}}</dt><dd class="text-right">{{timeAgo $row.updated_at}}</dd></div>
    </dl>
    <div class="flex items-center justify-between gap-3 border-t border-graphite-900/8 bg-mist/50 px-5 py-3">
        <div class="min-w-0 text-xs text-steel">
            <p class="font-semibold uppercase tracking-wide">{{__ "Owner history"}} <span class="font-normal normal-case">({{len .before}})</span></p>
            <p class="mt-0.5 truncate">{{if .before}}{{__ "Last change :date" "date" (formatDate (index .before 0).created_at "d M Y")}}{{else}}{{__ "No owner changes yet."}}{{end}}</p>
        </div>
        <button type="button" class="btn-secondary h-8 shrink-0 px-3 text-xs" data-open-dialog="{{.dlg}}">{{icon "clock" "size-4"}} {{__ "View history"}}</button>
    </div>
    {{.history}}
    {{if .canHand}}
    <details class="border-t border-graphite-900/8 px-5 py-3 text-sm">
        <summary class="cursor-pointer font-medium text-signal-700">{{__ "Change owner"}}</summary>
        <form method="POST" action="{{url (printf "/crm/%s/%v/owner" .path $row.id)}}" class="mt-3 space-y-2">
            {{csrfField}}
            {{select "to" .targets "" (dict "placeholder" (__ "New owner…") "aria" (__ "New owner") "search" true "required" true)}}
            <input name="note" class="input" maxlength="250" placeholder="{{__ "Note (optional)"}}" aria-label="{{__ "Note"}}">
            {{if .all}}<label class="flex items-center gap-2 text-xs text-steel"><input type="checkbox" name="move_department" value="1" class="size-4 accent-signal-600"> {{__ "Also move it to the new owner's department"}}</label>{{end}}
            <button type="submit" class="btn-secondary w-full">{{__ "Change owner"}}</button>
        </form>
    </details>
    {{end}}
</section>
