{{- /* Lead → Quotes tab. .row (lead), .erp (Accounting usable), .quotes (connected), .choices (ERP customers to pick from), .canEdit, .connected */ -}}
{{- $base := url (printf "/crm/leads/%v" .row.id) -}}{{- $canEdit := .canEdit -}}
<section class="panel overflow-hidden">
    <div class="panel-head">
        <h2 class="panel-title">{{__ "Quotes"}}</h2>
        {{if .connected}}
            <span class="flex flex-wrap items-center gap-2 text-sm"><span class="inline-flex items-center gap-1.5 rounded-md bg-emerald-50 px-2 py-0.5 text-emerald-800">{{icon "link" "size-4"}} {{or .row.erp_customer_name (printf "#%v" .row.erp_customer_id)}} <span class="text-xs text-emerald-700/80">#{{.row.erp_customer_id}}</span></span>
                {{if .canEdit}}<form method="POST" action="{{$base}}/erp-disconnect" data-confirm="{{__ "Disconnect this lead from the ERP customer?"}}">{{csrfField}}<button class="btn-ghost h-8 px-2 text-xs">{{__ "Disconnect"}}</button></form>{{end}}</span>
        {{end}}
    </div>

    {{if not .erp}}
        <p class="px-5 py-8 text-center text-sm text-steel">{{__ "The ERP data is not available right now (the Accounting module is off or unavailable)."}}</p>
    {{else if not .connected}}
        <div class="px-5 py-8 text-center">
            <span class="mx-auto flex size-12 items-center justify-center rounded-full bg-mist text-steel">{{icon "link" "size-6"}}</span>
            <p class="mt-3 font-medium">{{__ "Not connected to an ERP customer yet"}}</p>
            <p class="mt-1 text-sm text-steel">{{__ "Connect finds the ERP customer with tax ID :tax and keeps its customer ID on this lead, so its quotes show here." "tax" .row.tax_id}}</p>
            {{if .choices}}
                <p class="mt-5 text-sm font-medium">{{__ "Several ERP customers have this tax ID. Choose one:"}}</p>
                <ul class="mx-auto mt-2 max-w-lg divide-y divide-graphite-900/6 rounded-lg text-left ring-1 ring-graphite-900/10">
                    {{range .choices}}
                    <li class="flex items-center gap-3 px-4 py-2.5">
                        <div class="min-w-0 flex-1"><p class="truncate font-medium">{{.name}}</p>
                            <p class="truncate text-xs text-steel">{{._sub}}</p></div>
                        {{if $canEdit}}<form method="POST" action="{{$base}}/erp-connect">{{csrfField}}<input type="hidden" name="customer_id" value="{{.id}}"><button class="btn-secondary h-8 px-3 text-xs">{{__ "Connect"}}</button></form>{{end}}
                    </li>
                    {{end}}
                </ul>
            {{else if .canEdit}}
                <form method="POST" action="{{$base}}/erp-connect" class="mt-4">{{csrfField}}<button class="btn-primary">{{icon "link" "size-4"}} {{__ "Connect"}}</button></form>
            {{else}}
                <p class="mt-3 text-xs text-steel">{{__ "Someone who can edit this lead can connect it."}}</p>
            {{end}}
        </div>
    {{else if not .quotes}}
        <p class="px-5 py-8 text-center text-sm text-steel">{{__ "This ERP customer has no quotes."}}</p>
    {{else}}
    <div class="overflow-x-auto"><table class="w-full text-sm">
        <thead class="bg-mist/60 text-left text-xs text-steel"><tr>
            <th class="px-5 py-2 font-medium">{{__ "Quote no."}}</th><th class="px-3 py-2 font-medium">{{__ "Seller"}}</th>
            <th class="px-3 py-2 font-medium">{{__ "Date"}}</th><th class="px-3 py-2 font-medium">{{__ "Valid until"}}</th>
            <th class="px-5 py-2 text-right font-medium">{{__ "Amount"}}</th></tr></thead>
        <tbody class="divide-y divide-graphite-900/6">
        {{range .quotes}}
            <tr>
                <td class="max-w-[18rem] px-5 py-2.5"><span class="font-medium tabular-nums">{{._no}}</span>
                    {{if .quote_description}}<span class="block truncate text-xs text-steel" title="{{.quote_description}}">{{.quote_description}}</span>{{end}}</td>
                <td class="px-3 py-2.5">{{._seller}}</td>
                <td class="whitespace-nowrap px-3 py-2.5 text-steel">{{if .quote_date}}{{formatDate .quote_date}}{{else}}—{{end}}</td>
                <td class="whitespace-nowrap px-3 py-2.5">{{if .valid_through_date}}<span class="{{if ._expired}}text-signal-700{{else}}text-steel{{end}}">{{formatDate .valid_through_date}}</span>{{if ._expired}} <span class="badge bg-signal-50 text-signal-800">{{__ "Expired"}}</span>{{end}}{{else}}—{{end}}</td>
                <td class="whitespace-nowrap px-5 py-2.5 text-right tabular-nums">{{._amount}}</td>
            </tr>
        {{end}}
        </tbody>
    </table></div>
    <p class="border-t border-graphite-900/8 px-5 py-2 text-xs text-steel">{{__ "Connected :date. Amounts before VAT, from the ERP." "date" (ternary (filled .row.erp_connected_at) (formatDate .row.erp_connected_at "d M Y") "")}}</p>
    {{end}}
</section>
