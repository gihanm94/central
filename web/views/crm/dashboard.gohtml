{{- set "crumbs" (list) -}}
<div class="flex flex-wrap items-end justify-between gap-4">
    <div class="min-w-0">
        <h1 class="page-title">{{__ "CRM overview"}}</h1>
        <p class="mt-1 text-sm text-steel">{{__ "Showing"}} <span class="font-medium text-graphite-900">{{.scopeName}}</span>{{if .memberName}} · {{.memberName}}{{end}}{{if .mine}} · {{__ "my records only"}}{{end}} · {{.periodFrom}} → {{.periodTo}}</p>
    </div>
    {{if not .hasPeople}}
    <div class="inline-flex rounded-md bg-white p-0.5 text-sm ring-1 ring-graphite-900/15" role="group" aria-label="{{__ "Whose records"}}">
        <a href="{{.linkAll}}" class="rounded px-3 py-1.5 {{if not .mine}}bg-graphite-900 font-medium text-white{{else}}text-steel hover:text-graphite-900{{end}}">{{__ "Department"}}</a>
        <a href="{{.linkMine}}" class="rounded px-3 py-1.5 {{if .mine}}bg-graphite-900 font-medium text-white{{else}}text-steel hover:text-graphite-900{{end}}">{{__ "My records"}}</a>
    </div>
    {{end}}
</div>
{{template "partials/range-bar" (dict "action" .rangeAction "range" .range "from" .from "to" .to "keep" .keep "selects" .selects)}}

{{if .reminders}}
<section class="mt-5 rounded-lg bg-amber-50 p-4 ring-1 ring-amber-600/25" aria-label="{{__ "Reminders"}}">
    <h2 class="flex items-center gap-2 text-sm font-semibold text-amber-900">{{icon "bell" "size-4"}} {{__ "Reminders"}}</h2>
    <ul class="mt-2 space-y-1 text-sm text-amber-900">
        {{range .reminders}}
        <li><a href="{{.URL}}" class="font-medium underline-offset-2 hover:underline">{{.Topic}}</a> · {{.Meta}}</li>
        {{end}}
    </ul>
</section>
{{end}}

<div class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-5">
    {{range .tiles}}
    <section class="panel p-5">
        <h2 class="text-xs font-medium text-steel">{{.Label}}</h2>
        <p class="figure mt-2 text-4xl {{.Tone}}">{{.Figure}}</p>
        <p class="mt-2 text-xs text-steel">{{.Note}}</p>
    </section>
    {{end}}
</div>

{{with .target}}
<section class="panel mt-6 w-full">
    <div class="panel-head">
        <div><h2 class="panel-title">{{__ "Revenue vs target :year" "year" .year}}</h2>
            <p class="text-xs text-steel">{{.sub}}</p></div>
        {{if .setURL}}<a href="{{.setURL}}" class="text-sm text-steel hover:text-graphite-900">{{__ "Set targets"}}</a>{{end}}
    </div>
    <div class="grid gap-px bg-graphite-900/6 sm:grid-cols-2 lg:grid-cols-5">
        {{range .cells}}
        <div class="bg-white px-5 py-4 {{if .Now}}bg-signal-50/40{{end}}">
            <p class="flex items-center justify-between text-xs font-medium text-steel"><span>Q{{.Q}}{{if .Now}} · {{__ "now"}}{{end}}</span><span class="tabular-nums">{{.Pct}}</span></p>
            <p class="figure mt-2 text-2xl">{{.Actual}}</p>
            <p class="mt-1 text-xs text-steel">{{.Of}}</p>
            <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-graphite-900/8"><div class="h-full rounded-full" style="{{css (printf "width: %d%%; background: %s" .Width .Color)}}"></div></div>
        </div>
        {{end}}
        <div class="bg-white px-5 py-4">
            <p class="flex items-center justify-between text-xs font-medium text-steel"><span>{{__ "Year"}}</span><span class="tabular-nums">{{.yearPct}}</span></p>
            <p class="figure mt-2 text-2xl">{{.yearActual}}</p>
            <p class="mt-1 text-xs text-steel">{{.yearOf}}</p>
            <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-graphite-900/8"><div class="h-full rounded-full" style="{{css (printf "width: %d%%; background: %s" .yearWidth .yearColor)}}"></div></div>
        </div>
    </div>
    {{if .none}}<p class="border-t border-graphite-900/6 px-5 py-3 text-xs text-steel">{{__ "No target set for this year yet."}}</p>{{end}}
</section>
{{end}}

<div class="mt-6 grid gap-6 lg:grid-cols-5">
    <section class="panel lg:col-span-3">
        <div class="panel-head"><h2 class="panel-title">{{__ "Open pipeline by stage"}}</h2><span class="text-xs text-steel">{{__ "Value in :cur" "cur" .cur}}</span></div>
        <ul class="space-y-4 p-5">
            {{range .bars}}
            <li>
                <div class="mb-1.5 flex items-baseline justify-between gap-3 text-sm">
                    <a href="{{.URL}}" class="flex items-center gap-2 font-medium hover:text-signal-700"><span class="size-2.5 rounded-full" style="{{css (printf "background: %s" .Color)}}"></span>{{.Label}}</a>
                    <span class="tabular-nums text-steel">{{.Counts}}<span class="font-medium text-graphite-900">{{.Money}}</span>
                    </span>
                </div>
                <div class="h-5 rounded bg-graphite-900/5" title="{{.Title}}"><div class="h-full rounded-r" style="{{css (printf "width: %s%%; background: %s" .Width .Color)}}"></div></div>
            </li>
            {{end}}
        </ul>
        {{if .holdN}}<p class="border-t border-graphite-900/6 px-5 py-3 text-xs text-steel">{{.holdText}}</p>{{end}}
    </section>

    <section class="panel flex flex-col lg:col-span-2">
        <div class="panel-head"><h2 class="panel-title">{{__ "Won by month"}}</h2><span class="text-xs text-steel">{{__ "Value in :cur" "cur" .cur}}</span></div>
        {{if .monthsEmpty}}
            <p class="px-5 py-12 text-center text-sm text-steel">{{__ "No opportunities won in the last 6 months."}}</p>
        {{else}}
            {{template "crm/dash-bars" (dict "label" (__ "Won value by month") "ticks" .wonTicks "cols" .wonCols)}}
        {{end}}
    </section>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-2">
    <section class="panel flex flex-col">
        <div class="panel-head"><h2 class="panel-title">{{__ "New leads by month"}}</h2><span class="text-xs text-steel">{{__ "Leads created, year by year"}}</span></div>
        {{if .leadsEmpty}}
            <p class="px-5 py-12 text-center text-sm text-steel">{{__ "No new leads in these months."}}</p>
        {{else}}
            {{template "crm/dash-lines" (dict "label" (__ "New leads by month") "ticks" .leadTicks "months" .leadMonths "series" .leadSeries)}}
        {{end}}
    </section>
    <section class="panel flex flex-col">
        <div class="panel-head"><h2 class="panel-title">{{__ "Deals won and lost"}}</h2>
            <span class="flex items-center gap-3 text-xs text-steel"><span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-sm" style="background:#16a34a"></span>{{__ "Won"}}</span><span class="inline-flex items-center gap-1.5"><span class="size-2.5 rounded-sm" style="background:#e5484d"></span>{{__ "Lost"}}</span></span></div>
        {{if .closedEmpty}}
            <p class="px-5 py-12 text-center text-sm text-steel">{{__ "No deals closed in these months."}}</p>
        {{else}}
            {{template "crm/dash-bars" (dict "label" (__ "Deals won and lost by month") "ticks" .closedTicks "cols" .closedCols)}}
        {{end}}
    </section>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-2">
    <section class="panel">
        <div class="panel-head"><h2 class="panel-title">{{__ "Activities to do"}}</h2><a href="{{url "/crm/activities" "status" "PLANNED"}}" class="text-sm text-steel hover:text-graphite-900">{{__ "See all"}}</a></div>
        {{if not .ups}}<p class="px-5 py-8 text-center text-sm text-steel">{{__ "Nothing planned."}}</p>{{else}}
        <ul class="divide-y divide-graphite-900/6">
            {{range .ups}}
            <li><a href="{{.URL}}" class="flex items-center justify-between gap-3 px-5 py-3 hover:bg-mist/50">
                <span class="min-w-0"><span class="block truncate text-sm font-medium">{{.Topic}}</span>
                    <span class="block truncate text-xs text-steel">{{.Meta}}</span></span>
                <span class="shrink-0 text-right text-xs tabular-nums {{if .IsLate}}font-medium text-signal-700{{else}}text-steel{{end}}">{{.When}}{{if .IsLate}}<span class="block">{{.Late}}</span>{{end}}</span>
            </a></li>
            {{end}}
        </ul>
        {{end}}
    </section>

    <section class="panel">
        <div class="panel-head"><h2 class="panel-title">{{__ "Biggest open opportunities"}}</h2><a href="{{url "/crm/opportunities"}}" class="text-sm text-steel hover:text-graphite-900">{{__ "See all"}}</a></div>
        {{if not .tops}}<p class="px-5 py-8 text-center text-sm text-steel">{{__ "No open opportunities."}}</p>{{else}}
        <ul class="divide-y divide-graphite-900/6">
            {{range .tops}}
            <li><a href="{{.URL}}" class="flex items-center justify-between gap-3 px-5 py-3 hover:bg-mist/50">
                <span class="min-w-0"><span class="block truncate text-sm font-medium">{{.Name}}</span>
                    <span class="block truncate text-xs text-steel">{{.Meta}}</span></span>
                <span class="shrink-0 text-right"><span class="block text-sm font-medium tabular-nums">{{.Money}}</span>{{.Stage}}</span>
            </a></li>
            {{end}}
        </ul>
        {{end}}
    </section>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-3">
    {{template "crm/dash-industries" (dict "heading" (__ "Leads by industry") "d" .industryDist)}}
    {{template "crm/dash-sources" (dict "heading" (__ "Leads by source") "d" .sourceDist)}}

    <section class="panel">
        <div class="panel-head"><h2 class="panel-title">{{__ "Active campaigns"}}</h2><a href="{{url "/crm/campaigns"}}" class="text-sm text-steel hover:text-graphite-900">{{__ "See all"}}</a></div>
        {{if not .camps}}<p class="px-5 py-8 text-center text-sm text-steel">{{__ "No active campaigns."}}</p>{{else}}
        <ul class="divide-y divide-graphite-900/6">
            {{range .camps}}
            <li class="px-5 py-3"><a href="{{.URL}}" class="text-sm font-medium hover:text-signal-700">{{.Name}}</a>
                <p class="text-xs text-steel">{{.Ends}}</p>
                {{if .HasMeter}}<div class="mt-1.5">{{.Meter}}</div>{{end}}</li>
            {{end}}
        </ul>
        {{end}}
    </section>
</div>

{{if .compare}}
<section class="panel mt-6 overflow-hidden">
    <div class="panel-head"><h2 class="panel-title">{{__ "Departments"}}</h2><span class="text-xs text-steel">{{__ "Value in :cur" "cur" .cur}}</span></div>
    <div class="overflow-x-auto">
        <table class="table">
            <thead class="bg-mist/60"><tr><th>{{__ "Department"}}</th><th class="text-right">{{__ "Leads"}}</th><th class="text-right">{{__ "Open opportunities"}}</th><th class="text-right">{{__ "Open pipeline"}}</th><th class="text-right">{{__ "Won this year"}}</th><th class="text-right">{{__ "Overdue activities"}}</th></tr></thead>
            <tbody>
            {{range .compare}}
                <tr class="hover:bg-mist/40">
                    <td class="font-medium">{{if .ID}}<a href="{{.URL}}" class="hover:text-signal-700">{{.Name}}</a>{{else}}{{.Name}}{{end}}</td>
                    <td class="text-right tabular-nums">{{.Leads}}</td>
                    <td class="text-right tabular-nums">{{.Open}}</td>
                    <td class="text-right tabular-nums">{{.Pipeline}}</td>
                    <td class="text-right tabular-nums">{{.Won}}</td>
                    <td class="text-right tabular-nums {{if .HasOverdue}}font-medium text-signal-700{{end}}">{{.Overdue}}</td>
                </tr>
            {{end}}
            </tbody>
        </table>
    </div>
</section>
{{end}}
<p class="mt-4 text-xs text-steel">{{.footnote}}</p>
{{template "crm/dash-drawer" (dict "id" "industry" "heading" (__ "Leads by industry") "d" .industryDist)}}
{{template "crm/dash-drawer" (dict "id" "source" "heading" (__ "Leads by source") "d" .sourceDist)}}
<script>(function(){
    var open=null,last=null;
    function show(id){var s=document.getElementById('dist-'+id);if(!s)return;last=document.activeElement;open=s;s.hidden=false;document.body.classList.add('overflow-hidden');var q=s.querySelector('[data-dist-search]');if(q){q.value='';filter(s,'');q.focus({preventScroll:true});}}
    function hide(){if(!open)return;open.hidden=true;open=null;document.body.classList.remove('overflow-hidden');if(last&&last.focus)last.focus();}
    function filter(s,v){v=v.trim().toLowerCase();var n=0;s.querySelectorAll('[data-dist-row]').forEach(function(r){var ok=!v||r.dataset.name.indexOf(v)>-1;r.hidden=!ok;if(ok)n++;});var e=s.querySelector('[data-dist-empty]');if(e)e.hidden=n>0;}
    document.addEventListener('click',function(e){var o=e.target.closest('[data-dist-open]');if(o){e.preventDefault();show(o.dataset.distOpen);}else if(e.target.closest('[data-dist-close]')){hide();}});
    document.addEventListener('input',function(e){if(e.target.matches('[data-dist-search]'))filter(e.target.closest('[data-dist-sheet]'),e.target.value);});
    document.addEventListener('keydown',function(e){if(e.key==='Escape')hide();});
})();</script>


{{- define "crm/dash-bars"}}
<div class="flex flex-1 flex-col px-5 pb-4 pt-5" role="img" aria-label="{{.label}}">
    <div class="relative flex-1" style="min-height:14rem">
        {{range $i, $t := .ticks}}
        <div class="absolute left-0 right-0 border-t border-graphite-900/8" style="top:{{printf "%.0f" (mul $i 25)}}%"><span class="absolute left-0 text-[11px] tabular-nums text-steel" style="top:-9px;background:#fff;padding-right:4px">{{$t}}</span></div>
        {{end}}
        <div class="absolute flex items-stretch gap-2" style="left:3rem;right:0;top:0;bottom:0">
            {{range .cols}}
            <div class="flex min-w-0 flex-1 items-end justify-center gap-1" title="{{.Title}}">
                {{range .Bars}}
                <div class="flex h-full min-w-0 flex-1 flex-col items-center justify-end" style="max-width:2.75rem">
                    <span class="mb-1 truncate text-[11px] font-medium tabular-nums text-graphite-700">{{.Val}}</span>
                    <div class="w-full" style="height:{{.H}}%;background:{{.Color}};border-radius:6px 6px 0 0;min-height:{{if eq .H "0"}}2px{{else}}0{{end}};{{if eq .H "0"}}opacity:.25{{end}}"></div>
                </div>
                {{end}}
            </div>
            {{end}}
        </div>
    </div>
    <div class="flex gap-2" style="padding-left:3rem">
        {{range .cols}}<span class="min-w-0 flex-1 truncate pt-2 text-center text-xs {{if .Cur}}font-semibold text-graphite-900{{else}}text-steel{{end}}">{{.Label}}</span>{{end}}
    </div>
</div>
{{end -}}

{{- define "crm/dash-line"}}
<div class="flex flex-1 flex-col px-5 pb-4 pt-5" role="img" aria-label="{{.label}}">
    <div class="relative flex-1" style="min-height:14rem">
        {{range $i, $t := .ticks}}
        <div class="absolute left-0 right-0 border-t border-graphite-900/8" style="top:{{printf "%.0f" (mul $i 25)}}%"><span class="absolute left-0 text-[11px] tabular-nums text-steel" style="top:-9px;background:#fff;padding-right:4px">{{$t}}</span></div>
        {{end}}
        <div class="absolute" style="left:3rem;right:0;top:0;bottom:0">
            <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="absolute" style="inset:0;width:100%;height:100%;overflow:visible" aria-hidden="true">
                <polygon points="{{.area}}" fill="#2a78d6" fill-opacity=".12"/>
                <polyline points="{{.line}}" fill="none" stroke="#2a78d6" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
            </svg>
            {{range .cols}}
            <div class="absolute" style="left:{{.X}}%;bottom:{{.Y}}%;width:0;height:0" title="{{.Title}}">
                <span class="absolute rounded-full bg-white" style="width:10px;height:10px;left:-5px;bottom:-5px;border:2.5px solid #2a78d6"></span>
                {{range .Bars}}<span class="absolute text-[11px] font-medium tabular-nums text-graphite-700" style="bottom:9px;left:-20px;width:40px;text-align:center">{{.Val}}</span>{{end}}
            </div>
            {{end}}
        </div>
    </div>
    <div class="flex" style="padding-left:3rem">
        {{range .cols}}<span class="min-w-0 flex-1 truncate pt-2 text-center text-xs {{if .Cur}}font-semibold text-graphite-900{{else}}text-steel{{end}}">{{.Label}}</span>{{end}}
    </div>
</div>
{{end -}}

{{- define "crm/dash-lines"}}
<div class="flex flex-1 flex-col px-5 pb-4 pt-5" role="img" aria-label="{{.label}}">
    <div class="relative flex-1" style="min-height:14rem">
        {{range $i, $t := .ticks}}
        <div class="absolute left-0 right-0 border-t border-graphite-900/8" style="top:{{printf "%.0f" (mul $i 25)}}%"><span class="absolute left-0 text-[11px] tabular-nums text-steel" style="top:-9px;background:#fff;padding-right:4px">{{$t}}</span></div>
        {{end}}
        <div class="absolute" style="left:3rem;right:0;top:0;bottom:0">
            <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="absolute" style="inset:0;width:100%;height:100%;overflow:visible" aria-hidden="true">
                {{range .series}}
                {{if .Cur}}<polygon points="{{.Area}}" fill="{{.Color}}" fill-opacity=".10"/>{{end}}
                <polyline points="{{.Line}}" fill="none" stroke="{{.Color}}" stroke-width="{{if .Cur}}3.5{{else}}2{{end}}" {{if not .Cur}}stroke-opacity=".75" stroke-dasharray="6 4"{{end}} stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
                {{end}}
            </svg>
            {{range .series}}{{$cur := .Cur}}{{$color := .Color}}
            {{range .Points}}
            <div class="absolute" style="left:{{.X}}%;bottom:{{.Y}}%;width:0;height:0;{{if $cur}}z-index:2{{end}}" title="{{.Title}}">
                <span class="absolute rounded-full bg-white" style="{{if $cur}}width:10px;height:10px;left:-5px;bottom:-5px;border:2.5px solid {{$color}}{{else}}width:6px;height:6px;left:-3px;bottom:-3px;background:{{$color}}{{end}}"></span>
                {{if and $cur (ne .Val "0")}}<span class="absolute text-[11px] font-semibold tabular-nums text-graphite-900" style="bottom:9px;left:-20px;width:40px;text-align:center">{{.Val}}</span>{{end}}
            </div>
            {{end}}
            {{end}}
        </div>
    </div>
    <div class="flex" style="padding-left:3rem">
        {{range .months}}<span class="min-w-0 flex-1 truncate pt-2 text-center text-xs text-steel">{{.}}</span>{{end}}
    </div>
    <div class="mt-4 flex flex-wrap items-center justify-center gap-2" style="padding-left:3rem">
        {{range .series}}
        <span class="inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs {{if .Cur}}font-semibold text-graphite-900{{else}}text-steel{{end}}" style="{{if .Cur}}background:{{.Color}}1a;box-shadow:inset 0 0 0 1px {{.Color}}66{{else}}box-shadow:inset 0 0 0 1px rgba(0,0,0,.08){{end}}">
            <span style="display:inline-block;width:18px;height:0;border-top:{{if .Cur}}3px solid{{else}}2px dashed{{end}} {{.Color}}"></span>{{.Year}}<span class="tabular-nums {{if .Cur}}text-graphite-700{{end}}">· {{.Total}}</span>
        </span>
        {{end}}
    </div>
</div>
{{end -}}

{{- define "crm/dash-industries"}}
{{- $d := .d -}}
<section class="panel flex flex-col">
    <div class="panel-head"><h2 class="panel-title">{{.heading}}</h2>{{if $d.Kinds}}<span class="text-xs text-steel">{{__ ":n industries" "n" $d.Kinds}}</span>{{end}}</div>
    {{if not $d.Top}}<p class="px-5 py-8 text-center text-sm text-steel">{{__ "No data yet."}}</p>{{else}}
    <ol class="flex-1 divide-y divide-graphite-900/6">
        {{range $d.Top}}
        <li class="px-5 py-2.5">
            <div class="flex items-center gap-3 text-sm">
                <span class="w-4 shrink-0 text-right text-xs tabular-nums text-steel">{{.Rank}}</span>
                <span class="min-w-0 flex-1 truncate font-medium">{{.Name}}</span>
                <span class="shrink-0 tabular-nums font-semibold">{{.N}}</span>
                <span class="w-12 shrink-0 text-right text-xs tabular-nums text-steel">{{.Share}}%</span>
            </div>
            <div class="ml-7 mt-1.5 h-1 rounded-full bg-graphite-900/6"><div class="h-full rounded-full" style="{{css (printf "width: %s%%; background: %s" .Width .Color)}}"></div></div>
        </li>
        {{end}}
    </ol>
    <div class="flex items-center justify-between gap-3 border-t border-graphite-900/6 px-5 py-3 text-xs text-steel">
        <span>{{if $d.MoreKinds}}{{__ "+ :n more industries · :leads leads (:pct%)" "n" $d.MoreKinds "leads" $d.MoreN "pct" $d.MoreShare}}{{else}}{{__ "All industries are shown."}}{{end}}</span>
        {{if $d.MoreKinds}}<button type="button" class="btn-secondary !py-1 text-xs" data-dist-open="industry">{{__ "View all :n" "n" $d.Kinds}}</button>{{end}}
    </div>
    {{end}}
</section>
{{end -}}

{{- define "crm/dash-sources"}}
{{- $d := .d -}}
<section class="panel flex flex-col">
    <div class="panel-head"><h2 class="panel-title">{{.heading}}</h2>{{if $d.Kinds}}<span class="text-xs text-steel">{{__ ":n sources" "n" $d.Kinds}}</span>{{end}}</div>
    {{if not $d.Top}}<p class="px-5 py-8 text-center text-sm text-steel">{{__ "No data yet."}}</p>{{else}}
    <div class="flex flex-1 flex-col items-center gap-5 p-5">
        <div class="relative shrink-0" style="width:9rem;height:9rem" role="img" aria-label="{{.heading}}">
            <div class="rounded-full" style="width:100%;height:100%;{{css $d.Donut}}"></div>
            <div class="absolute flex flex-col items-center justify-center rounded-full bg-white" style="inset:1.6rem">
                <span class="figure text-2xl leading-none">{{$d.Total}}</span><span class="mt-1 text-[11px] text-steel">{{__ "leads tagged"}}</span>
            </div>
        </div>
        <ul class="w-full space-y-2">
            {{range $d.Top}}
            <li class="flex items-center gap-2 text-sm"><span class="size-2.5 shrink-0 rounded-full" style="{{css (printf "background: %s" .Color)}}"></span><span class="min-w-0 flex-1 truncate">{{.Name}}</span><span class="tabular-nums font-semibold">{{.N}}</span><span class="w-12 text-right text-xs tabular-nums text-steel">{{.Share}}%</span></li>
            {{end}}
            {{if $d.MoreKinds}}<li class="flex items-center gap-2 text-sm text-steel"><span class="size-2.5 shrink-0 rounded-full" style="background:#cbd5e1"></span><span class="min-w-0 flex-1 truncate">{{__ "Other (:n)" "n" $d.MoreKinds}}</span><span class="tabular-nums font-semibold text-graphite-900">{{$d.MoreN}}</span><span class="w-12 text-right text-xs tabular-nums">{{$d.MoreShare}}%</span></li>{{end}}
        </ul>
    </div>
    {{if $d.MoreKinds}}<div class="flex justify-end border-t border-graphite-900/6 px-5 py-3"><button type="button" class="btn-secondary !py-1 text-xs" data-dist-open="source">{{__ "View all :n" "n" $d.Kinds}}</button></div>{{end}}
    {{end}}
</section>
{{end -}}

{{- define "crm/dash-drawer"}}
{{- $d := .d -}}
<div id="dist-{{.id}}" class="fixed inset-0 z-[60]" hidden data-dist-sheet>
    <div class="absolute inset-0 bg-graphite-950/50" data-dist-close></div>
    <aside role="dialog" aria-modal="true" aria-label="{{.heading}}" class="absolute inset-y-0 right-0 flex w-[min(26rem,calc(100vw-1rem))] flex-col bg-white shadow-2xl">
        <header class="flex items-center justify-between gap-3 border-b border-graphite-900/10 px-5 py-3">
            <div class="min-w-0"><h2 class="truncate text-base font-semibold">{{.heading}}</h2><p class="text-xs text-steel">{{__ ":n leads tagged" "n" $d.Total}}</p></div>
            <button type="button" class="btn-ghost !px-2" data-dist-close aria-label="{{__ "Close"}}">&times;</button>
        </header>
        <div class="border-b border-graphite-900/8 px-5 py-3"><input type="search" data-dist-search placeholder="{{__ "Search"}}…" class="input" autocomplete="off"></div>
        <ul class="min-h-0 flex-1 divide-y divide-graphite-900/6 overflow-y-auto">
            {{range $d.All}}
            <li class="px-5 py-2.5" data-dist-row data-name="{{lower .Name}}">
                <div class="flex items-center gap-3 text-sm"><span class="w-6 shrink-0 text-right text-xs tabular-nums text-steel">{{.Rank}}</span><span class="size-2.5 shrink-0 rounded-full" style="{{css (printf "background: %s" .Color)}}"></span><span class="min-w-0 flex-1 truncate">{{.Name}}</span><span class="tabular-nums font-semibold">{{.N}}</span><span class="w-12 text-right text-xs tabular-nums text-steel">{{.Share}}%</span></div>
                <div class="ml-9 mt-1.5 h-1 rounded-full bg-graphite-900/6"><div class="h-full rounded-full" style="{{css (printf "width: %s%%; background: %s" .Width .Color)}}"></div></div>
            </li>
            {{end}}
            <li class="px-5 py-8 text-center text-sm text-steel" data-dist-empty hidden>{{__ "Nothing found."}}</li>
        </ul>
    </aside>
</div>
{{end -}}
