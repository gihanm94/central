{{- /* .m .subject .date .doc .hasImages .reply */ -}}
{{- $m := .m -}}
<div class="flex flex-wrap items-center justify-between gap-3"><a href="{{url "/mail"}}" class="btn-ghost">‹ {{__ "Back to mail"}}</a><button type="button" class="btn-primary" data-compose>{{icon "mail" "size-4"}} {{__ "Reply"}}</button></div>
<section class="panel mt-3 overflow-hidden">
    <div class="border-b border-graphite-900/8 px-5 py-4"><h1 class="text-lg font-semibold">{{.subject}}</h1>
        <dl class="mt-2 grid gap-x-4 gap-y-0.5 text-sm sm:grid-cols-[auto_1fr]"><dt class="text-steel">{{__ "From"}}</dt><dd>{{$m.from}}</dd><dt class="text-steel">{{__ "To"}}</dt><dd class="break-words">{{$m.to}}</dd>
            {{if $m.cc}}<dt class="text-steel">Cc</dt><dd class="break-words">{{$m.cc}}</dd>{{end}}<dt class="text-steel">{{__ "Date"}}</dt><dd>{{.date}}</dd></dl>
        {{if $m.files}}<p class="mt-3 flex flex-wrap gap-2 text-xs">{{range $m.files}}<span class="rounded-md bg-mist px-2 py-1">📎 {{.name}}</span>{{end}}<span class="self-center text-steel">{{__ "Open the message in Gmail to download attachments."}}</span></p>{{end}}
        {{if .hasImages}}<p class="mt-3 text-xs text-steel">{{__ "Pictures from other websites are hidden to protect your privacy."}} <a class="text-signal-700 hover:underline" href="{{url (printf "/mail/%s" $m.id) "images" 1}}">{{__ "Show pictures"}}</a></p>{{end}}</div>
    <iframe sandbox title="{{__ "Message"}}" srcdoc="{{.doc}}" class="h-[65vh] w-full border-0 bg-white"></iframe>
</section>
{{template "mail/compose" (dict "reply" .reply)}}
