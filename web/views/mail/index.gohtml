{{- /* .connected .configured .label .labels [[href label on]] .q .rows .next .estimate .error .email .lost .page .older */ -}}
<div class="flex flex-wrap items-end justify-between gap-4">
    <div class="min-w-0"><h1 class="page-title">{{__ "Mail"}}</h1><p class="mt-1 text-sm text-steel">{{if .connected}}{{.email}}{{else}}{{__ "Your Gmail, inside the system."}}{{end}}</p></div>
    {{if .connected}}<button type="button" class="btn-primary" data-compose>{{icon "mail" "size-4"}} {{__ "Compose"}}</button>{{end}}
</div>
{{if not .connected}}
<div class="panel mt-4 p-8 text-center"><p class="text-base font-medium">{{if .lost}}{{__ "Your Google connection ended. Connect again to see your e-mail here."}}{{else}}{{__ "Connect your Google account to see your e-mail here."}}{{end}}</p>
    {{if .lost}}<p class="mx-auto mt-2 max-w-xl rounded-lg bg-signal-50 px-3 py-2 text-sm text-signal-800">{{.lost}}</p>{{end}}
    {{if .configured}}<a href="{{url "/connect/google" "back" "mail"}}" class="btn-primary mt-4">{{icon "link" "size-4"}} {{if .lost}}{{__ "Connect again"}}{{else}}{{__ "Connect Google"}}{{end}}</a>
    {{else}}<p class="mt-2 text-sm text-steel">{{__ "The administrator has not set up the Google connector yet."}}</p>{{end}}</div>
{{else}}
<div class="mt-4 flex flex-wrap items-center gap-2">
    <nav class="inline-flex gap-1 rounded-lg bg-white p-1 shadow-sm ring-1 ring-graphite-900/10">{{range .labels}}<a href="{{index . 0}}" class="rounded-md px-3 py-1.5 text-sm {{if index . 2}}bg-signal-600 font-medium text-white{{else}}text-steel hover:bg-mist{{end}}">{{index . 1}}</a>{{end}}</nav>
    <form method="GET" action="{{url "/mail"}}" class="ml-auto flex items-center gap-2">{{if ne .label "INBOX"}}<input type="hidden" name="label" value="{{.label}}">{{end}}<input name="q" value="{{.q}}" class="input !h-9 w-64" placeholder="{{__ "Search mail…"}}"><button class="btn-secondary !h-9">{{__ "Search"}}</button></form>
</div>
{{if .error}}<p class="mt-3 rounded-lg bg-signal-50 px-4 py-3 text-sm text-signal-800">{{.error}}</p>{{end}}
<section class="panel mt-3 overflow-hidden"><ul class="divide-y divide-graphite-900/6">
    {{range $m := .rows}}
    <li><a href="{{url (printf "/mail/%s" $m.ID)}}" class="flex items-center gap-4 px-4 py-3 hover:bg-mist/50 {{if $m.Unread}}bg-signal-50/30{{end}}">
        <span class="w-44 shrink-0 truncate text-sm {{if $m.Unread}}font-semibold{{end}}">{{$m.Name}}</span>
        <span class="min-w-0 flex-1 truncate text-sm"><span class="{{if $m.Unread}}font-semibold{{end}}">{{$m.Subject}}</span> <span class="text-steel">— {{$m.Snippet}}</span></span>
        <span class="shrink-0 text-xs text-steel">{{$m.Date}}</span></a></li>
    {{end}}
    {{if and (not .rows) (not .error)}}<li class="px-5 py-10 text-center text-sm text-steel">{{__ "Nothing here."}}</li>{{end}}
</ul>
{{if .older}}<div class="flex items-center justify-between border-t border-graphite-900/8 px-4 py-2.5 text-sm text-steel"><a class="btn-secondary !h-8 !px-3" href="javascript:history.back()">‹ {{__ "Newer"}}</a><span>{{.estimate}}+</span>
    <a class="btn-secondary !h-8 !px-3 {{if not .next}}pointer-events-none opacity-40{{end}}" href="{{.older}}">{{__ "Older"}} ›</a></div>{{end}}
</section>
{{template "mail/compose" (dict "reply" nil)}}
{{end}}
