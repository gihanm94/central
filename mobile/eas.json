{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": false,
      "distribution": "internal",
      "env": { "APP_VARIANT": "development", "EXPO_PUBLIC_API_URL": "http://10.0.2.2:8000" },
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "env": { "APP_VARIANT": "preview", "EXPO_PUBLIC_API_URL": "https://staging.example.com" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "APP_VARIANT": "production", "EXPO_PUBLIC_API_URL": "https://erp.example.com" }
    }
  },
  "submit": { "production": {} }
}
